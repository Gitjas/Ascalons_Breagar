@125 = ~Có¿, przyznajê, ¿e wola³bym, aby <CHARNAME> dzia³a³ czasem mniej chaotycznie.~ ~Có¿, przyznajê, ¿e wola³bym, aby <CHARNAME> dzia³a³a czasem mniej chaotycznie.~
@126 = ~Ale do licha, co to w³aœciwie udowadnia?~
@127 = ~Mo¿e nic, Breagarze.~
@128 = ~Musisz jednak przyznaæ, ¿e nie brzmi to dobrze. Mo¿e chcesz coœ dodaæ od siebie, <CHARNAME>?~
@129 = ~Musisz przyznaæ, ¿e mog³oby to brzmieæ lepiej. Mo¿e chcesz coœ dodaæ od siebie, <CHARNAME>?~
@130 = ~Twoje s³owa brzmi¹ rozs¹dnie. Ale mo¿e ty chcesz coœ dodaæ, <CHARNAME>?~
@131 = ~Pope³niasz b³¹d, pani. Nie chcê zasi¹œæ na Krwawym Tronie!~
@132 = ~A co ja mogê na to powiedzieæ? Co ma byæ, to bêdzie.~
