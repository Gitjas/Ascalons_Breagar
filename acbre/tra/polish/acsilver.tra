@138 = ~Tak, sta³o siê.~
@139 = ~Wiêc wiesz, co musisz zrobiæ.~
@140 = ~Tak, wiem. Skoro taka jest wola bogów, niech siê wype³ni. Szykuj siê, <CHARNAME>!~
@141 = ~Nie, wys³anniczko. Nic nie jest jasne.~
