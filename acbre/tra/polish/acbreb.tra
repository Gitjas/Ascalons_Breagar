@211 = ~Czy ktoœ ci kiedyœ mówi³, ¿e masz tendencje do skupiania siê na negatywach?~
@212 = ~Phi, jesteœ pewna, ¿e nie zapomnia³aœ o ma³ym szczególe? Ten idiota mo¿e chcieæ siê odwin¹æ!~
@213 = ~I myœlisz, ¿e to mu coœ pomo¿e?~
@214 = ~Hej, ty tam!~
@215 = ~Czego chcesz? To nie twój interes!~
@216 = ~Tak, siê sk³ada, ¿e w³aœnie go sobie przyw³aszczy³em! Zostawisz tê biedn¹ duszê w spokoju, albo porozmawiamy inaczej!~
@217 = ~Nie masz pojêcia, z kim zadzierasz!~
@218 = ~Buzzurk.~
@219 = ~Œwietnie. Zgadnijcie, kto teraz bêdzie siê przechwala³ przez najbli¿sze dni... *wzdycha*~
@220 = ~¯aden krasnolud nigdy nie stanie po stronie Wygnañca!~
@221 = ~Przyjdzie ci stan¹æ na drodze grupie, któr¹ dowodzi <CHARNAME>!~
@222 = ~G³upi krasnoludzie, naprawdê myœlisz, ¿e mnie to choæ trochê obchodzi? Jedna œmieræ, dwie czy szeœæ, jakie to ma znaczenie?~
@223 = ~Po³o¿ymy kres twoim niegodziwoœciom, potworze! Tu i teraz staniesz przed s¹dem!~
@224 = ~Nigdy!~
@225 = ~O niebiosa, czy nikt ju¿ nie potrafi zostaæ martwy na dobre? Tym razem posiekam ciê na malutkie kawa³eczki!~
@226 = ~Bruahahaha, chodŸ i spróbuj!~
@227 = ~Na lœni¹ce kamienie Dumathoina! Tak odra¿aj¹ca zbrodnia wymaga pomsty!~
@228 = ~*dr¿y*~
@229 = ~Nie jesteœ w nastroju do pogaduszek, co? Dobra, przemówimy jêzykiem, który zrozumiesz!~
@230 = ~Ma³a-piêœæ zginie!~
@231 = ~To umieraj! Maguñciu!~
