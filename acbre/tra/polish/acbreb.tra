@186 = ~Tutaj zginiecie!~
@187 = ~No ja na przyk³ad jestem bliski za³amania nerwowego i jeszcze bli¿szy obicia gêby nastêpnej osobie, która zada mi jakieœ durne pytanie!~
@188 = ~Wracajcie do swoich dziur, zanim przejdê od s³ów do czynów!~
@189 = ~Uspokój siê, bo skoñczysz marnie, zupe³nie jak twoi przyjaciele!~
@190 = ~Hej, ch³opcze. Spokojnie, co? Tylko mi tu teraz nie mdlej!~ ~Hej, dziewczyno. Spokojnie, co? Tylko mi tu teraz nie mdlej!~
@191 = ~Na... na... Buzzurk. Nie mia³em pojêcia, ¿e krew Bhaala mo¿e siê w tobie tak objawiæ! Na bogów – oby mi ju¿ nigdy nie przysz³o ogl¹daæ... czegoœ takiego!~
@192 = ~O nie, nie dokonasz swojej zemsty, to my j¹ wymierzymy! Szykuj siê! Zaraz zap³acisz za swoje niegodziwe czyny!~
@193 = ~Ty! Skrêcê ci kark, plugawy szczurze wodny!~
@194 = ~Spokojnie! Nie róbmy niczego, czego moglibyœmy póŸniej ¿a³owaæ!~
@195 = ~Jeœli chcesz znaæ moje zdanie, to jakakolwiek groza czyha za tym portalem, blednie ona w porównaniu z horrorem ponownego wejœcia na statek!~
@196 = ~Ca³kowicie siê z tob¹ zgadzam, ale myœlê, ¿e <CHARNAME> te¿ ma tu coœ do powiedzenia.~
@197 = ~Mamy aborda¿ na pe³nym morzu! Walamy siê po tej... tej... krypie, a ty mi mówisz, ¿ebym siê nie martwi³? Czyœ ty doszczêtnie oszala³?~
@198 = ~Spokojnie, mamy wszystko pod kontrol¹!~
