@207 = ~Wybaczcie, mój panie. Mój towarzysz cierpi na chroniczny ból w prawym kolanie.~
@208 = ~Och, biedaczysko. No dobrze, na czym to skoñczyliœmy?~
@209 = ~(Jakby rozmiar mia³ jakiekolwiek znaczenie... phi.)~
