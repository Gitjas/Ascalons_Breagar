@287 = ~Phi. 300 z³ota za nasze us³ugi? To jak za darmo. Tylko pilnuj siê, dziewko!~
@288 = ~<CHARNAME>, przecie¿ to nie s¹ ¿adne zbiry. Ktoœ tu nas próbuje wystrychn¹æ na dudka!~
@289 = ~P³acê wam ciê¿kie pieni¹dze, wiêc oczekujê efektów!~
@290 = ~Jesteœ przeklêtym draniem, <CHARNAME>! Zostaw tych ludzi w spokoju!~
@291 = ~Zabijcie go te¿!~
@292 = ~O, przysz³e pokolenia bêd¹ ci na pewno wdziêczne. Czy mo¿na lepiej zadbaæ o spuœciznê ni¿ tym twoim okropnym wyciem!~
@293 = ~Hm, jesteœ ignorantem i zawsze nim bêdziesz!~
@294 = ~Ty przeklêty plugawicielu ¿elaza, œmiesz nas pouczaæ o manierach? Tu i teraz staniesz przed s¹dem. Giñ!~
@295 = ~Trzymaj jêzyk za zêbami!~
@296 = ~¯ycie u twego boku nigdy nie jest nudne, <CHARNAME>. Ale niech mnie kule bij¹, nic nigdy nie bola³o bardziej ni¿ ten odwrót.~
@297 = ~O, wci¹¿ tu jesteœ...~
@298 = ~Znalaz³eœ te przeklête bêkarty, a teraz chcesz, by usz³o im to p³azem? Jesteœ naprawdê durnym ch³ystkiem, <CHARNAME>.~ ~Znalaz³eœ te przeklête bêkarty, a teraz chcesz, by usz³o im to p³azem? Jesteœ naprawdê durn¹ dziewuch¹, <CHARNAME>.~
@299 = ~Skoro tak sprawiasz sprawê, to nie mam innego wyjœcia! Zginiesz tu i teraz!~
@300 = ~Wszystko jest lepsze od tego nie-¿ycia!~
@301 = ~Czeka ciê tylko jedna œmieræ i nikt ciê przed ni¹ nie uratuje!~
@302 = ~Przyjmij swój ostateczny koniec!~
@303 = ~Na pocz¹tek mo¿e przesta³byœ trajkotaæ jak idiota i zgarn¹³ czêœæ tych swoich gratów? Masz tu jeden wielki chlew!~
@304 = ~Breagarze, co ja ci mówi³em? Zamknij jadaczkê przy klientach!~
@305 = ~Breagarze, co ci mówi³em? Jeœli s¹ klienci, to masz trzymaæ tê swoj¹ przeklêt¹ jadaczkê na k³ódkê!~
@306 = ~Zdrada! Szykuj siê na karê, przeklêty magu!~
@307 = ~Jestem twoj¹ zgub¹!~
@308 = ~¯ebym to dobrze zrozumia³ – sprowadzi³eœ elfkê, ¿eby zbada³a kopalniê?~
@309 = ~Mieliœmy swoje powody. Ale na tym, ¿e do nas do³¹czysz, mo¿emy tylko zyskaæ. Nieprawda¿, mistrzu krasnoludzie?~
@310 = ~¯ebym to dobrze zrozumia³ – sprowadzi³eœ elfa, ¿eby zbada³ kopalniê?~
@311 = ~¯ebym to dobrze zrozumia³ – sprowadzi³eœ maga, ¿eby zbada³ kopalniê?~
@312 = ~¯ebym to dobrze zrozumia³ – sprowadzi³eœ nizio³ka, ¿eby zbada³ kopalniê?~
@313 = ~No ju¿, ch³opcze. Uspokój siê. Zaraz pomyœlimy, jak mo¿emy ci pomóc, dobrze?~
@314 = ~*poci¹ga nosem*~
@315 = ~Œwiêta racja, Minscu! Niech nas prowadzi <CHARNAME>!~
@316 = ~Racja! Minsc, Boo i Breagar, zjednoczeni w walce ze z³em!~
@317 = ~Hej, co ty wyprawiasz?~
@318 = ~A³a!~
@319 = ~Mamy lepkie r¹czki, co?~
@320 = ~Proszê, tylko nie k³adŸ tam tego topora!~
@321 = ~Potrafisz sobie wyobraziæ, co spotyka ludzi, którzy kradn¹ krasnoludowi?~
@322 = ~Mój panie! Topór! B³agam!~
@323 = ~Mo¿e powinienem daæ ci lekcjê, której nigdy nie zapomnisz, co, ch³opcze?~
@324 = ~Oooch, nie nie nie nie! Ju¿ siê nauczy³em! Nie kradnie siê krasnoludom! Oddam wszystko, a nawet wiêcej, tylko b³agam, zabierz st¹d ten topór, proszê ciê!~
@325 = ~Hrmf. W porz¹dku. Ale lepiej, ¿ebym ciê wiêcej nie przy³apa³, ch³opcze.~
@326 = ~UFF!~
@327 = ~A co powiesz na to, ¿ebyœmy wys³ali ciê do piek³a, byœ móg³ przetrzeæ szlak Sarevokowi, szumowino!~
@328 = ~Ty trafisz tam pierwszy!~
@329 = ~Phi. Nic dziwnego, ¿e ludzie nigdy nie potrafi¹ nawi¹zaæ porz¹dnej wiêzi ze swoim z³otem, skoro tak lekkomyœlnie rozdaj¹ je ka¿demu, kto zapuœci byle jak¹ brodê.~
@330 = ~*wzdycha*~
@331 = ~Ty jesteœ jednym z tych plugawicieli ¿elaza? I jeszcze siê do tego przyznajesz? O <CHARNAME>! Proszê, zostaw mnie z nim sam na sam na parê minut!~
@332 = ~O panie, b³agam, nie rób tego!~ ~O pani, b³agam, nie rób tego!~
@333 = ~Nie zabroniê ci spróbowaæ, ale nie b¹dŸ zbyt rozczarowany, jeœli nic z tego nie wyjdzie!~
@334 = ~No có¿, <CHARNAME>, mam nadziejê, ¿e twój plan nie by³ zbyt skomplikowany, bo w³aœnie leg³ w gruzach.~
@335 = ~Niewolnicy w krasnoludzkiej kopalni! Buzzurk, te... berchosloraschgarzim zap³ac¹ za tê zniewagê!~
@336 = ~Pomó¿ mi, a ja pomogê ci dokonaæ zemsty.~
@337 = ~Mo¿esz na to liczyæ, przyjacielu! Ci przeklêci poganiacze niewolników po¿a³uj¹, ¿e z nami zadarli!~
@338 = ~Pod³a bestio! No dalej, poka¿ siê, ¿ebym móg³ zetrzeæ ten uœmieszek z twojej gêby!~
@339 = ~Cierpliwoœci, drogi krasnoludzie. Na ciebie te¿ przyjdzie kolej.~
@340 = ~S³ysza³em o tym mieczu, <CHARNAME>. Dobra robota, solidnie wykuty, spe³nia swoje zadanie, o ile umiesz siê nim pos³ugiwaæ, ale sprowadzi³ œmieræ na niejednego ch³ystka z marn¹ brod¹, któremu nagle siê zdawa³o, ¿e jest niezwyciê¿ony.~
@341 = ~Och, proszê, nie mów takich rzeczy!~
@342 = ~No ju¿, zmykaj st¹d, durny dzieciaku. Mama czeka.~
@343 = ~Tak, jeszcze raz dziêkujê!~
@344 = ~Phi! A ty siê pytasz, dlaczego rozs¹dne krasnoludy nie ufaj¹ morzu. Nie doœæ, ¿e jest nieprzewidywalne, to jeszcze na dok³adkê trzeba siê u¿eraæ z band¹ szalonych bóstw!~
@345 = ~Proszê, nie mów tak, kiedy jesteœ blisko wody!~
@346 = ~Myœlisz, ¿e wie? Zabawne, ale nie wygl¹dasz na kogoœ, kto mo¿e mi tu rozkazywaæ!~
@347 = ~W tym lesie obowi¹zuj¹ nasze prawa i bêdziesz ich przestrzegaæ.~
@348 = ~Phi! Plugawy miocie, zma¿emy was z powierzchni tego œwiata!~
@349 = ~Jedyne, co was czeka, to cierpienie!~
@350 = ~Gdybym ciê nie zna³, <CHARNAME>, powiedzia³bym, ¿e przyci¹gasz dziwaków niczym œwiat³o æmy.~
@351 = ~Dziwaków? Musisz byæ w b³êdzie! Boo to najrozs¹dniejszy i najnormalniejszy chomik na tym œwiecie!~
@352 = ~*wzdycha* To bêdzie d³uga podró¿...~
@353 = ~Naprzód! Skopaæ ty³ki w dobrej sprawie!~
@354 = ~Ciekawe, ¿e o to pytasz...~
@355 = ~Ach, daj spokój, <CHARNAME>. Nie patrz tak na mnie.~
@356 = ~Przestañ skamleæ i poka¿ siê, ty niebieskoskóra szumowino!~
@357 = ~Krasnolud nas nienawidzi! Krasnolud za to pocierpi!~
@358 = ~Nie podoba mi siê to, <CHARNAME>. Magia zawsze zwiastuje k³opoty.~
@359 = ~Mam nadziejê, ¿e mój wybawca siê z tym nie zgadza.~ ~Mam nadziejê, ¿e moja wybawczyni siê z tym nie zgadza.~
@360 = ~M¹dre s³owa.~
@361 = ~Helm jest m¹dry i sprawiedliwy.~
@362 = ~Ha, spróbuj nas tylko zatrzymaæ!~
@363 = ~Phi, zanim spuœcimy ci zas³u¿ony ³omot za tê obelgê, odpowiedz mi na jedno – jak w mroku nocy odró¿niasz swoj¹ dziewuchê od tego hobgoblina? Pewnie zdarzy³o ci siê, ¿e œci¹gn¹³eœ nie te portki, co trzeba?~
@364 = ~Znudzi³o ci siê ¿ycie, co? Powiedz swojemu brodatemu kumplowi, ¿eby trzyma³ gêbê na k³ódkê, albo sami go uciszymy!~
@365 = ~Zapraszam!~
@366 = ~Chciwe bandziory, wasz odór zatruwa drogi. Wyci¹gajcie miecze!~
@367 = ~Oto nasze pieni¹dze. Mo¿emy ju¿ iœæ?~
@368 = ~Spokojnie, przyjacielu. Myœlisz, ¿e to m¹dre obra¿aæ nieznajomych z tak¹ wielk¹ broni¹?~
@369 = ~Takie groŸby s¹ poni¿ej mojego poziomu i tylko potwierdzaj¹ moj¹ racjê.~
@370 = ~<CHARNAME>! Brak mi s³ów, by wyraziæ, jak bardzo brzydz¹ mnie czasem twoje decyzje.~
@371 = ~Milcz, œmiertelniku! Albo wielki Tiax wtr¹ci ciê do otch³ani wiecznego potêpienia!~
@372 = ~Jeszcze jedno s³owo, a wielki Tiax zaraz siê przekona, kto kogo i gdzie bêdzie wtr¹ca³. Buzzurk!~
@373 = ~Przeklête szkodniki. Z mi³¹ chêci¹ zosta³bym tu chwilê d³u¿ej, ¿eby wepchn¹æ parê tych bestii z powrotem do ich dziur.~
@374 = ~Odwa¿na postawa, mój przyjacielu.~
@375 = ~Pod³a kreaturo! Szykuj siê, zaraz zap³acisz za ten posi³ek!~
@376 = ~Na bogów, uspokój siê, drogi przyjacielu. Mój ty œwiecie, chyba muszê siê nauczyæ trzymaæ jêzyk za zêbami przy krasnoludach.~
@377 = ~No coœ na pewno bêdziemy musieli zrobiæ.~
@378 = ~Naprawdê s¹dzi³eœ, ¿e kobieta tak ³atwo porzuci rodzinê? Jesteœ dziwnym, durnym ch³ystkiem.~ ~Naprawdê s¹dzi³eœ, ¿e kobieta tak ³atwo porzuci rodzinê? Jesteœ dziwn¹, durn¹ dziewuch¹.~
@379 = ~Skoro tak to chcesz rozegraæ, nêdzniku! Na Clangeddina, niech œmieræ przyjdzie po ciebie szybko!~
@380 = ~Bar'uk zdaje siê byæ jakimœ szaleñcem. Jesteœ gotów poprzeæ te s³owa czynami?~
@381 = ~Krasnolud siê przekona! Powinien milczeæ! Do mnie, s³ugi!~
@382 = ~Phi. Wygrzebywanie zmar³ych tylko po to, ¿eby poznaæ w³asn¹ historiê. ¯a³osne!~
@383 = ~Wiedza nie gromadzi siê sama, mistrzu krasnoludzie.~
@384 = ~To weŸcie porz¹dny kamieñ i d³uto! Utrwalcie swoje s³owa tak, ¿eby przysz³e pokolenia mog³y je przeczytaæ bez przetrz¹sania waszych koœci!~
@385 = ~Có¿, w tym konkretnym przypadku twoja rada jest nieco spóŸniona, nie s¹dzisz?~
@386 = ~Wiedzia³em. Ale oczywiœcie krasnoluda nigdy nie bierze siê na powa¿nie.~
@387 = ~Nastêpnym razem zapamiêtam twoje s³owa.~
@388 = ~Ty to wykona³eœ? A niech mnie, <CHARNAME>. To jest cholerne arcydzie³o. To chyba najpiêkniejsza rzecz, jak¹ widzia³em poza salami mojego klanu. Jeœli masz choæ krztynê pojêcia o sztuce, powinieneœ pozwoliæ temu cz³owiekowi dokoñczyæ pracê.~ ~Ty to wykona³eœ? A niech mnie, <CHARNAME>. To jest cholerne arcydzie³o. To chyba najpiêkniejsza rzecz, jak¹ widzia³em poza salami mojego klanu. Jeœli masz choæ krztynê pojêcia o sztuce, powinnaœ pozwoliæ temu cz³owiekowi dokoñczyæ pracê.~
@389 = ~Tak, proszê! Pomó¿cie mi! B³agam was!~
@390 = ~Có¿, niektórym z nas ca³kiem nieŸle wychodzi bycie krasnoludem przez ca³e ¿ycie.~
@391 = ~O tak, brzmi jak doskona³a zabawa. Hurra.~
@392 = ~Na mi³oœæ Berronar, coœ mi mówi, ¿e to bêdzie d³uga podró¿. Dobrze, ¿e jestem taki cierpliwy.~
@393 = ~To doœæ okrê¿ny sposób na proszenie siê o ³omot, dziewucho! Lepiej oka¿ trochê szacunku!~
@394 = ~Nie przypominam sobie, bym z tob¹ rozmawia³a!~
@395 = ~To patrz i podziwiaj, mo¿e siê czegoœ nauczysz!~
@396 = ~Masz niewyparzon¹ gêbê, krasnoludzie! S³ono za to zap³acisz!~
@397 = ~Jeœli ten szpiczastouchy naprawdê zna sposób na zarobienie z³ota, to powinniœmy go wys³uchaæ, <CHARNAME>. Ubrany jest doœæ idiotycznie, ale elfy zazwyczaj tak maj¹.~
@398 = ~W ustach krasnoluda brzmi to niemal jak komplement.~
@399 = ~Nale¿ysz do tych plugawicieli ¿elaza? Na topór Clangeddina, przeklniesz dzieñ, w którym siê tu zaszy³eœ!~
@400 = ~No dalej, najemniku. Spróbuj mnie aresztowaæ. Zobaczymy, kto z nas ostoi siê na nogach!~
@401 = ~Ostrzegam ciê! Wci¹¿ masz szansê stan¹æ przed s¹dem! Nie pogarszaj swojej sytuacji!~
@402 = ~Módl siê do swoich bogów, ¿ebyœmy siê ju¿ nigdy nie spotkali, gnomie. Bo ten dzieñ bêdzie twoim ostatnim.~
@403 = ~W twoim wieku mia³em wa¿niejsze rzeczy na g³owie ni¿ rozmyœlanie o ucieczce z domu. Ale domyœlam siê, ¿e wiesz co robisz, m³oda.~
@404 = ~Owszem, wiem.~
@405 = ~Dziesiêæ tysiê... Bierzemy bez gadania! Prawda, <CHARNAME>?~
@406 = ~O, widzê tu s³ynny krasnoludzki zmys³ do interesów.~
@407 = ~Jeszcze siê pytasz, poganiaczu niewolników? No dalej, broñ siê, ¿ebyœmy mogli ci odp³aciæ dok³adnie tak, jak na to zas³ugujesz!~
@408 = ~Nie wiesz, co robisz!~
@409 = ~Skopiemy ci ty³ek i uwolnimy niewolników! Masz dok³adnie jedn¹ szansê, ¿eby oddaæ klucz!~
@410 = ~Na brodê mojej babki! Nie mog¹ tak po prostu... <CHARNAME>! Musimy coœ zrobiæ!~
@411 = ~Buzzurk! Nie martw siê, Hendaku, nie musisz nas o nic prosiæ. Z radoœci¹ weŸmiemy siê za tych handlarzy niewolników. Prawda, <CHARNAME>?~
@412 = ~I to podejœcie rozumiem!~
@413 = ~Przeklête, podstêpne bêkarty, u¿ywaj¹ trucizny! To kwestia honoru. Musimy to odkrêciæ, <CHARNAME>.~
@414 = ~*kaszle*~
@415 = ~Oszala³eœ, durny ch³ystku? Marsz z powrotem! Pomo¿esz temu biedakowi!~ ~Oszala³aœ, durna dziewucho? Marsz z powrotem! Pomo¿esz temu biedakowi!~
@416 = ~W takim razie ponownie ich przegonimy. Buzzurk! Dopóki stawia im czo³a choæ jeden honorowy krasnolud, tym szubrawcom nie ujdzie to na sucho.~
@417 = ~Gdyby tylko wszyscy tak myœleli...~
@418 = ~Mo¿esz i masz racjê...~
@419 = ~Cieszê siê, ¿e mo¿na ci przemówiæ do rozs¹dku. A teraz zje¿d¿aj...~
@420 = ~Przemówiæ do rozs¹dku? Phi! Obawiam siê, ¿e mnie nie zrozumia³eœ! Rusz ty³ek z drogi i natychmiast wypuœæ tych ludzi, albo sam ci ten rozs¹dek do ³ba wbijê, ty nêdzny, ¿a³osny poganiaczu!~
@421 = ~Mocne s³owa jak na tak¹ niewyparzon¹ gêbê! Mo¿e lepiej wróæ do swej jaskini, zanim ka¿ê ci ¿reæ mój topór?~
@422 = ~Buzzurk! Utrata rodziny zawsze boli. Wspó³czujê ci, kap³anie.~
@423 = ~Dziêkujê ci, Breagarze. A teraz ty, mów!~
@424 = ~Trolle! Buzzurk! To wyjaœnia, dlaczego tylu poszukiwaczy przygód wczeœniej ci odmówi³o. To grubsza sprawa, dziewczyno.~
@425 = ~Owszem, ale teraz rozumiesz, dlaczego jestem tak zdesperowana!~
@426 = ~Mogê sobie tylko wyobraziæ, co czujesz, Nalio. Strata domu... Buzzurk.~
@427 = ~Dziêkujê ci, Breagarze.~
@428 = ~Oczywiœcie, jeœli coœ idzie nie tak, zwykle stoi za tym jakiœ mag. Powinieneœ siê tym zaj¹æ.~
@429 = ~Mamy zwi¹zane rêce, mistrzu krasnoludzie.~
@430 = ~O tak, to brzmi doprawdy wiarygodnie. Spacerowanie po cmentarzu w œrodku nocy to coœ, co robi ka¿dy praworz¹dny obywatel, co? Phi!~
@431 = ~Drastyczne czasy wymagaj¹ drastycznych œrodków, przyjacielu.~
@432 = ~Tak, na przyk³ad takich, jak ja!~
@433 = ~Jasne, jakbyœmy nie mieli lepszych rzeczy do roboty! Buzzurk, nie daj siê nabraæ na tak oczywiste oszustwo, <CHARNAME>!~
@434 = ~...no i wszystkie dywany do wyrzucenia, jak mniemam, s¹dz¹c po buciorach tego... krasnoluda.~
@435 = ~Spokojnie, paniusiu. Powinnaœ byæ dla mnie nieco bardziej uprzejma.~
@436 = ~Uprzejma? Dla ciebie? Och, przestañ, nie b¹dŸ œmieszny.~
@437 = ~Przestañ siê tak we mnie wpatrywaæ, Imoen!~
@438 = ~Och, ja... *chrz¹ka*~
@439 = ~Breagarze, chcia³am tylko powiedzieæ, ¿e mi przykro. No wiesz... Z powodu tego, co ci siê sta³o.~
@440 = ~Rozumiem.~
@441 = ~To... to wszystko?~
@442 = ~A co mo¿na tu jeszcze dodaæ?~
@443 = ~Zazwyczaj ludzie siê ciesz¹, gdy mówi im siê mi³e rzeczy.~
@444 = ~I chcesz, ¿ebym ja siê cieszy³? Moje ¿ycie leg³o w gruzach, ale za to mam twoje wspó³czucie?~
@445 = ~Có¿... tak. Przynajmniej odrobinê.~
@446 = ~Hurra. A teraz zostaw mnie w spokoju.~
@447 = ~Hrmf. Imoen?~
@448 = ~Czemu tak za mn¹ kr¹¿ysz?~
@449 = ~S³uchaj, dziewczyno. Doceniam twoje wspó³czucie, naprawdê. Po prostu trudno mi to teraz okazaæ, rozumiesz?~
@450 = ~No, sama nie wiem...~
@451 = ~Na brodê Moradina, przecie¿ próbujê ciê tu przeprosiæ! Nie pajacuj ju¿, i tak czujê siê wystarczaj¹co g³upio!~
@452 = ~*chichocze* Ale wygl¹dasz tak zabawnie! Oczywiœcie, ¿e ci wybaczam, Breagarze. Pod jednym warunkiem.~
@453 = ~Jakim?~
@454 = ~¯e znowu bêdziesz ze mn¹ normalnie rozmawia³.~
@455 = ~*wzdycha* Postaram siê.~
@456 = ~Tak!~
@457 = ~Imoen?~
@458 = ~Eee...~
@459 = ~*Imoen przybiera wyj¹tkowo niewinn¹ minê, gdy podchodzi do niej Breagar*.~
@460 = ~W czym mogê ci pomóc?~
@461 = ~Mo¿esz mi powiedzieæ, co ty niby wyprawiasz.~
@462 = ~Och... co ja wyprawiam?~
@463 = ~Nie myœl sobie, ¿e nie zauwa¿y³em! Od d³u¿szego czasu rzucasz we mnie ma³ymi kamyczkami!~
@464 = ~Och.~
@465 = ~Wiêc jednak zauwa¿y³eœ.~
@466 = ~Co u... oczywiœcie, ¿e zauwa¿y³em! Czy ty mnie masz za kompletnego idiotê!~
@467 = ~Nie, po prostu zastanawia³am siê, czy masz w ogóle czucie w tej swojej srebrnej rêce, wiêc ja...~
@468 = ~Imoen... mo¿esz po prostu zapytaæ. I... na mi³oœæ bosk¹! Przestañ mnie szczypaæ!~
@469 = ~Ojej, czy to boli?~
@470 = ~Nie, prawdê mówi¹c w ogóle nie mam czucia w tej rêce.~
@471 = ~Ale wygl¹da zabawnie.~
@472 = ~Niech ci bêdzie. Ale mog³eœ tak od razu powiedzieæ...~
@473 = ~Hej, m³oda.~
@474 = ~Tak, Breagarze?~
@475 = ~O co chodzi?~
@476 = ~Ty... ty siê chyba niczego nie boisz, co?~
@477 = ~Nie mam czasu na strach. Na topór Clangeddina, muszê znaleŸæ st¹d wyjœcie!~
@478 = ~Czy nie mia³byœ nic przeciwko... no, gdybym mog³a trzymaæ siê trochê bli¿ej ciebie?~
@479 = ~Hrmf.~
@480 = ~Proszê?~
@481 = ~Tylko jeœli przysiêgniesz, ¿e bêdziesz trzymaæ swoje lepkie palce przy sobie.~
@482 = ~*uœmiecha siê z ulg¹* Dziêkujê ci.~
@483 = ~I ¿eby daæ ci coœ do rozmyœlania... Gar vos nal ven des?~
@484 = ~O, czekaj! Eee... Kas vel nos ber Augmar Dakah.~
@485 = ~Niech mnie kule bij¹, o co znowu chodzi, m³oda?~
@486 = ~To znaczy?~
@487 = ~No to ja pytam ciebie. Myœlisz, ¿e nie widzê, jak siê na mnie ci¹gle gapisz?~
@488 = ~Ach, o to chodzi. Po prostu jestem ciekawa. W Candlekeep rzadko widuje siê krasnoludy.~
@489 = ~Doprawdy? A co z tym krzykaczem?~
@490 = ~Mówisz o Reevorze? Och, jego obchodz¹ tylko rekruci i piwo.~
@491 = ~Jeœli ktoœ z naszych bierze siê za jakieœ zadanie, to wykonuje je sumiennie. I on dok³adnie to robi!~
@492 = ~Ta, jasne. Nic nie mówi³am. O rety...~
@493 = ~Mogê ciê o coœ zapytaæ, Breagarze?~
@494 = ~Nawet jak powiem „nie”, to i tak nie zamkniesz jadaczki, co?~
@495 = ~Bo kr¹¿y taka plotka o krasnoludach...~
@496 = ~*wzdycha* Jaka znowu plotka?~
@497 = ~No, to trochê krêpuj¹ce, ale...~
@498 = ~Czy krasnoludy wykluwaj¹ siê z kamieni?~
@499 = ~Co takiego? Buzzurk, kto ci nagada³ takich bzdur?~
@500 = ~Tak gdzieœ s³ysza³am, wiêc pomyœla³am...~
@501 = ~No toœ teraz dowiod³a, ¿e jednak NIE MYŒLA£AŒ! Moja matka to honorowa, porz¹dna krasnoludka. Wykluwanie siê z kamieni... *parska* Phi!~
@502 = ~Proszê, nie z³oœæ siê, ja tylko...~
@503 = ~Zaraz mnie spytasz, czy zajadamy siê wêglem, co? S³uchaj, m³oda. ¯aden krasnolud nigdy nie wype³z³ ze ska³y. Krasnoludy rozmna¿aj¹ siê dok³adnie tak samo jak ludzie. Rozumiesz?~
@504 = ~Hm... nie do koñca. A jak rozmna¿aj¹ siê ludzie?~
@505 = ~To znaczy... eee. Mo¿e niech ktoœ inny ci to wyjaœni.~
@506 = ~Tchórz.~
@507 = ~O nie! Mnie w to nie wmieszasz!~
@508 = ~Co znowu?~
@509 = ~Mówi³eœ ostatnio o krasnoludzkich kobietach. Nigdy ¿adnej nie widzia³am. Jakie one s¹?~
@510 = ~Hrmf. Piêkne istoty. Silne i twarde. Porz¹dna krasnoludka potrafi jednoczeœnie zaj¹æ siê domem, rodzin¹, prac¹ i odpêdziæ stado koboldów.~
@511 = ~No i ich brody...~
@512 = ~*parska* Co?~
@513 = ~Co „co”? Buzzurk, z czego siê œmiejesz?~
@514 = ~Po prostu... myœla³am, bo... nigdy wczeœniej nie widzia³am kobiety z brod¹.~
@515 = ~Jest mnóstwo rzeczy, których nigdy nie widzia³aœ, niem¹dra dziewucho.~
@516 = ~Ludzkim kobietom nie rosn¹ brody, elfkom te¿ nie.~
@517 = ~Phi, nawet wasi durni mê¿czyŸni gol¹ podbródki. Wygl¹daj¹ przez to jak œwie¿o odstawieni od cyca.~
@518 = ~Ja tam lubiê g³adko ogolonych facetów.~
@519 = ~Có¿, jak wszyscy ludzie, masz nie po kolei w g³owie.~
@520 = ~Czemu ci¹gle gapisz siê w to lustro, Imoen? Boisz siê, ¿e zestarzejesz siê zbyt szybko, jak to u waszych bywa?~
@521 = ~Co? O nie, po prostu zastanawia³am siê, jak bym wygl¹da³a z brod¹.~
@522 = ~Stroisz sobie ze mnie ¿arty?~
@523 = ~Nie, sk¹d¿e znowu. A ty nigdy siê nie zastanawia³eœ, jak byœ wygl¹da³ BEZ brody?~
@524 = ~A po co? Nie noszê brody dla urody, ma³a. To moja duma i honor, znak, ¿e jestem dojrza³y.~
@525 = ~A jeœli krasnolud nie ma brody?~
@526 = ~Krasnolud bez brody jest... than. To znaczy... ma³y, bezbronny, s³aby... jak brzd¹c, rozumiesz?~
@527 = ~Tyle zachodu o kêpê k³aków. Jesteœcie dziwnym ludem, Breagarze.~
@528 = ~I mówi to cz³owiek! Buzzurk!~
@529 = ~Breagarze, ja...~
@530 = ~Och, nie b¹dŸ taki. Myœla³am o naszej ostatniej rozmowie.~
@531 = ~Tak?~
@532 = ~Tak, o tym co mówi³eœ, ¿e krasnolud bez brody jest... fan?~
@533 = ~Than.~
@534 = ~Niewa¿ne. Wiêc teoretycznie, co jeœli walczysz z smokiem i tu¿ przed tym, jak go zabijesz, on zionie ci ogniem w twarz i spali ci brodê...~
@535 = ~Gdyby smoczy ogieñ trafi³ mnie prosto w gêbê, straci³bym znacznie wiêcej ni¿ tylko brodê.~
@536 = ~Albo... co jeœli mag rzuci w ciebie kul¹ ognia i broda...~
@537 = ~¯aden przeklêty mag nigdy nie dosta³by takiej szansy!~
@538 = ~Ale teoretycznie...~
@539 = ~Teoretycznie co?~
@540 = ~Teoretycznie krasnolud traci brodê podczas bohaterskiej bitwy. Albo coœ w tym stylu. Czy taki krasnolud nie by³by wci¹¿ bohaterem?~
@541 = ~Krasnolud, którego broda ucierpia³a w walce, wola³by skoczyæ z toporem prosto w paszczê smoka, ni¿ ¿yæ dalej z takim wstydem.~
@542 = ~Bezbrody krasnolud nigdy nie odnalaz³by siê w spo³eczeñstwie.~
@543 = ~Rozumiem.~
@544 = ~I to my niby jesteœmy dziwni?~
@545 = ~Och, marashrazbulnarazazdarzim! Te przeklête buciory mnie wykoñcz¹.~
@546 = ~Co w tym takiego œmiesznego, g³upia dziewczyno?~
@547 = ~To brzmi po prostu œwietnie.~
@548 = ~Krasnoludzki musi byæ wspania³ym jêzykiem do przeklinania.~
@549 = ~Ba. Krasnoludzki to jêzyk doskona³y, pierwszy, jakim kiedykolwiek mówiono w tej sferze, zanim powsta³y jakiekolwiek inne.~
@550 = ~Inne rasy mog³yby mieæ na ten temat odmienne zdanie.~
@551 = ~W takim razie s¹ w b³êdzie! Buzzurk!~
@552 = ~Czy móg³byœ... to znaczy... móg³byœ mnie nauczyæ?~
@553 = ~Krasnoludzkiego? Phi. Nigdy. Masz zbyt piskliwy g³os i zbyt w¹t³¹ szyjê. Ud³awi³abyœ siê przy pierwszym s³owie.~
@554 = ~Oooch, daj spokój. Nie b¹dŸ taki gelvos.~
@555 = ~Mam nie byæ... zakutym... ³bem?~
@556 = ~Widzisz? Potrafiê!~
@557 = ~Phi, g³upie dziecko. Wymówi³aœ to ca³kowicie Ÿle.~
@558 = ~To mnie naucz, proszê!~
@559 = ~Phi, mówiê ci, ¿e nic dobrego z tego nie wyniknie. Ale skoro chcesz siê oœmieszyæ, to proszê bardzo. Najpierw pozwól, ¿e...~
@560 = ~...i zawsze pamiêtaj. Orzeczenie idzie na pocz¹tek, a przydawki na koniec. Teraz przet³umacz to: „Imoen, walnij orka toporem w ³eb!”~
@561 = ~Hm... chwileczkê...~
@562 = ~Imoen, ged ork nos nyr?~
@563 = ~Hrmf. Có¿, prawie.~
@564 = ~Widzisz, dajê radê!~
@565 = ~<CHARNAME>, mówiê po krasnoludzku!~
@566 = ~Nie b¹dŸ taka pewna siebie, ma³a. Ledwie liznê³aœ podstawy.~
@567 = ~Niewa¿ne, uczmy siê dalej! Co teraz?~
@568 = ~*wzdycha* No dobrze. Jeœli chcesz podkreœliæ wypowiedŸ...~
@569 = ~Breagarze... eee, bak aurdrukar... eee... auraurn, bak aun?~
@570 = ~Có¿ to za durne pytanie?~
@571 = ~Próbowa³am tylko zapytaæ, czy w nastêpnej karczmie chcesz piwo, czy wodê.~
@572 = ~Piwo, to oczywiste.~
@573 = ~Jasne, ale...~
@574 = ~Wiêc nie zadawaj oczywistych pytañ.~
@575 = ~Chcia³am tylko pokazaæ, czego siê nauczy³am.~
@576 = ~Dziewczyno, to jedna z najwa¿niejszych lekcji. Bakahmos gund, gundgelm.~
@577 = ~Jeœli nie jesteœ... eee...~
@578 = ~Jeœli nie masz nic do powiedzenia, to trzymaj jêzyk za zêbami.~
@579 = ~Och. W porz¹dku.~
@580 = ~Chocia¿ nie robiê sobie wielkich nadziei...~
@581 = ~Och, widzê, jak jest. Nie ma czasu przywitaæ siê z krasnoludem, co?~
@582 = ~Breagarze! Ty te¿ przyszed³eœ. Nawet ciê nie zauwa¿y³am!~
@583 = ~No ju¿, nie d¹saj siê tak. Pozwól, ¿e ciê uœciskam!~
@584 = ~Hej, puœæ mnie. No ju¿, dobra! Buzzurk! Puœæ¿e mnie!~
@585 = ~Nic a nic siê nie zmieni³eœ, wiesz?~
@586 = ~A niby dlaczego mia³bym siê zmieniaæ? G³upia dziewczyna.~
@587 = ~Ach, tak mi³o znowu z tob¹ podró¿owaæ.~
@588 = ~Breagarze... Naprawdê p³yn¹³eœ statkiem? ¯eby mnie ratowaæ?~
@589 = ~Na b³ogos³awieñstwo Mordinsamman! Nawet mi o tym nie przypominaj!~
@590 = ~Och, to najs³odsza rzecz, jak¹ kiedykolwiek s³ysza³am, mog³abym ciê...~
@591 = ~Trzymaj siê z daleka! Jeden uœcisk wystarczy.~
@592 = ~Oj, nie b¹dŸ taki... to po prostu...~
@593 = ~*Imoen dr¿y*~
@594 = ~Po tym wszystkim, co siê sta³o... po prostu cieszê siê, ¿e znów jestem wœród przyjació³.~
@595 = ~Hrmf. Ja te¿ siê cieszê, ¿e wróci³aœ w jednym kawa³ku, m³oda. Naprawdê siê cieszê.~
@596 = ~Hm?~
@597 = ~Ty... wiesz ju¿, kim jestem, prawda? Pomiotem Bhaala, zupe³nie jak <CHARNAME>.~
@598 = ~Czy mo¿esz mi coœ obiecaæ?~
@599 = ~O co chodzi?~
@600 = ~Gdyby moje dziedzictwo kiedykolwiek przejê³o nade mn¹ kontrolê. Gdybym... zmieni³a siê w potwora czy coœ... <CHARNAME> poprosi³ ciê, byœ przysi¹g³, ¿e go zg³adzisz.~ ~Gdyby moje dziedzictwo kiedykolwiek przejê³o nade mn¹ kontrolê. Gdybym... zmieni³a siê w potwora czy coœ... <CHARNAME> poprosi³a ciê, byœ przysi¹g³, ¿e j¹ zg³adzisz.~
@601 = ~Zgadza siê.~
@602 = ~Czy móg³byœ obiecaæ mi to samo?~
@603 = ~Ja... proszê ciê.~
@604 = ~Dobrze. Obiecujê.~
@605 = ~*patrzy na Breagara z wdziêcznoœci¹*~
@606 = ~Dziêkujê.~
@607 = ~Twoje magiczne moce wzros³y, co?~
@608 = ~Tak! Œwietnie, prawda?~
@609 = ~Och, wci¹¿ jesteœ taki zrzêdliwy, jeœli chodzi o magiê? Za³o¿ê siê, ¿e ostatnio parê razy ci siê przyda³a.~
@610 = ~Hrmf. Powiedzmy tylko, ¿e ostatnio magia nie wyrz¹dza tylu szkód, co zwykle.~
@611 = ~*chichocze* A mówiê ci, ¿e przyjdzie taki dzieñ, w którym bêdziesz wdziêczny za rzucone zaklêcie.~
@612 = ~Niech bogowie do tego nie dopuszcz¹.~
@613 = ~Vel.. erm... Vel nosnyr baz gurbak na dwardek?~
@614 = ~*Przez chwilê wygl¹da na skonsternowanego, po czym k¹ciki jego ust unosz¹ siê w uœmiechu – to rzadki widok*.~
@615 = ~Ah nosmyr gez dwardek. Bakah rez therdek nes kar.~
@616 = ~*Imoen œmieje siê*~
@617 = ~Bakah vel nyrmoz.~
@618 = ~Zapamiêta³aœ wszystko, co?~
@619 = ~Co do s³owa.~
@620 = ~Breagarze, nigdy nie rozmawiasz o Audhild.~
@621 = ~O czym tu rozmawiaæ, m³oda?~
@622 = ~Spêdzi³eœ tyle lat pracuj¹c nad swoim arcydzie³em, a teraz to wszystko przepad³o. Jak mo¿esz o tym nie rozmawiaæ?~
@623 = ~Co siê sta³o, to siê nie odstanie, Imoen. Nikomu nie pomogê rwaniem brody z frustracji. Nie na tak¹ pomoc liczy <CHARNAME>.~
@624 = ~Czy ty naprawdê myœlisz tylko o tym, czego potrzebuje <CHARNAME>?~
@625 = ~Phi. Gdyby tak by³o, musia³bym sprawdziæ, czy mam jeszcze wszystkie klepki na miejscu. Nie, przede wszystkim myœlê o tych wszystkich szubrawcach, którym wci¹¿ jestem winien ³omot. Ka¿demu z nich odp³acê w swoim czasie.~
@626 = ~Có¿, w takim razie nie powinniœmy ju¿ d³u¿ej zwlekaæ.~
@627 = ~W niektórych sprawach lepiej milczeæ.~
@628 = ~Ale dlaczego? Nie cieszysz siê z tego?~
@629 = ~G³upia dziewczyno! Oczywiœcie, ¿e tak.~
@630 = ~To mi to poka¿!~
@631 = ~Chcesz, ¿ebym skaka³ i wrzeszcza³ jak oszala³y gibberling? Zapomnij.~
@632 = ~Chcesz zapytaæ o coœ konkretnego, dziewczyno?~
@633 = ~Co? Och... ja....~
@634 = ~Hrmf. Wyduœ to z siebie, zanim ci szyja spuchnie. Albo zanim oszalejê od tego twojego ci¹g³ego wzdychania.~
@635 = ~Ja... ja tylko chcia³am ciê zapytaæ... pochodzisz z gór, Breagarze, i chcia³am wiedzieæ, czy mo¿e widzia³eœ tam kogoœ podobnego do mnie.~
@636 = ~Podobnego do ciebie? J¹kaj¹ce siê elfi¹tka czcz¹ce g³upich gnomich bogów?~
@637 = ~Ja... mia³am na myœli avariel, Breagarze. Skrzydlate elfy.~
@638 = ~Hrmf. Nie, nigdy nas tacy nie niepokoili.~
@639 = ~Dlaczego... dlaczego jesteœ taki z³oœliwy?~
@640 = ~Phi. Z³oœliwy? Niewiele widzia³aœ œwiata, co? Inaczej nie myli³abyœ szczeroœci ze z³oœliwoœci¹.~
@641 = ~Widzia³am ju¿ wystarczaj¹co du¿o, Breagarze! Wiêcej ni¿ bym chcia³a! Na pewno doœæ, by odró¿niæ szczeroœæ od z³oœliwoœci!~
@642 = ~Phi.~
@643 = ~Och, wiesz co? Zapomnij o tym.~
@644 = ~Hrmf. Aerie?~
@645 = ~O co chodzi? Kolejne obelgi?~
@646 = ~Nie. W³aœciwie to chcia³em ciê przeprosiæ.~
@647 = ~Ty... chcesz mnie przeprosiæ?~
@648 = ~Mog³aœ mieæ racjê. Moje s³owa mog³y brzmieæ z³oœliwie w twoich uszach.~
@649 = ~Jesteœ strasznym gburem, wiesz o tym?~
@650 = ~Ale skoro mówisz, ¿e ci przykro, to ci wybaczê.~
@651 = ~Mo¿e... porozmawiamy póŸniej?~
@652 = ~Mo¿e tak.~
@653 = ~Dobra, ruszajmy dalej.~
@654 = ~*Breagar idzie cicho, pogr¹¿ony w myœlach*.~
@655 = ~ŒMIERTELNIKU! S£UCHAJ S£ÓW POTÊ¯NEGO TIAXA!~
@656 = ~Przeklêty gnomi pomiot! Zabijê ciê, jeœli jeszcze raz tak zrobisz!~
@657 = ~Jak œmiesz groziæ wielkiemu Tiaxowi! Znasz swoje miejsce! Milcz i s³uchaj jego orêdzia!~
@658 = ~Och, znam swoje miejsce. Jest w³aœnie tutaj, przy zamykaniu twojej przeklêtej jadaczki!~
@659 = ~Nêdzna szumowino, miocie przeklêtego œcierwojada! Wszechpotê¿ny Tiax, w swej ³asce i mi³osierdziu, postanowi³ daæ ci ostatni¹ szansê, byœ móg³ siê wykazaæ, a ty j¹ odrzucasz? Za to spêdzisz ca³¹ wiecznoœæ w najg³êbszym lochu królestwa Cyrica, gdzie...~
@660 = ~Milcz!~
@661 = ~...twoje flaki bêd¹ co rano wyci¹gane z twojego trêdowatego cia³a roz¿arzonymi szczypcami...~
@662 = ~B¹dŸ cicho, mówiê.~
@663 = ~...siarka i lawa bêd¹ twoim jedynym pokarmem i napojem, twoje paznokcie u nóg zostan¹ przebite gwoŸdziami, a twoje plecy bêd¹ smagane jadowitymi wê¿ami...~
@664 = ~Nie bêdê powtarza³!~
@665 = ~...parchy bêd¹ pokrywaæ twoj¹ g³owê dniem i noc¹, robactwo oblezie twoje cia³o i wgryzie siê w twoje miêso, a twoja broda...~
@666 = ~Na topór Clangeddina! Mam doœæ! Milcz! Zamknij tê swoj¹ przeklêt¹ gêbê, bo ci powybijam zêby! Na mi³oœæ bosk¹ i wszystko, co œwiête, na moj¹ przyjaŸñ z kimœ takim jak <CHARNAME> i na wszystkie wielkie czyny, na wszystkie wielkie czyny, jakie s¹ nam pisane, przysiêgam – powiedz jeszcze jedno s³owo, a PRZESTANÊ nad sob¹ panowaæ!~
@667 = ~No dobrze! Mój ty œwiecie, ale¿ jesteœmy dzisiaj dra¿liwi...~
@668 = ~Nalio, wci¹¿ narzekasz na swoj¹ rodzinê i inne szlacheckie rody.~
@669 = ~Czy nie mam ku temu licznych powodów? Widzê, jak szlachta wyzyskuje swoich poddanych...~
@670 = ~I tak nie powinnaœ potêpiaæ swojej rodziny w taki sposób, dziewczyno.~
@671 = ~Co ty mo¿esz wiedzieæ o byciu zamkniêt¹ w domu, pod ci¹g³ym nadzorem... ty...~
@672 = ~Jestem bezpoœrednim potomkiem Gotrika Bardormara, Nalio. Doskonale wiem, co to znaczy byæ pod nadzorem przez ca³e ¿ycie.~
@673 = ~Tak, ale... nie przeszkadza ci to?~
@674 = ~Phi, g³upie dziecko. Jeœli wykonujê dobr¹ robotê, to dlaczego mia³oby mi przeszkadzaæ, ¿e ktoœ mi patrzy na rêce?~
@675 = ~Pyta³aœ mnie o swój lud, Aerie.~
@676 = ~Tak... i powiedzia³eœ, ¿e...~
@677 = ~Wiem, co powiedzia³em, ale mój dom, góry Burzowych Rogów, nie jest odpowiednim miejscem dla elfów. A ju¿ na pewno nie dla tych skrzydlatych. Lodowate wiatry, poszarpane urwiska. To nie jest mi³a okolica.~
@678 = ~Naprawdê jest tam a¿ tak Ÿle?~
@679 = ~Na tyle Ÿle, ¿e twoim pobratymcom by siê tam nie spodoba³o.~
@680 = ~Po prostu... jest nas tak niewielu. Eony temu smoki niemal wytêpi³y nasz lud.~
@681 = ~Phi, smoki. Przeklêta plaga.~
@682 = ~Ty... to znaczy twój lud... wy te¿ macie z nimi problemy, prawda?~
@683 = ~O, mo¿esz byæ tego PEWNA jak tego, ¿e... *odchrz¹kuje*... tak.~
@684 = ~Czy to dlatego, ¿e smoki kochaj¹ z³oto tak samo jak krasnoludy?~
@685 = ~Hrmf. Krasnoludy wcale nie kochaj¹ z³ota.~
@686 = ~Nie?~
@687 = ~Nie. My mu to tylko wmawiamy, ¿eby zaci¹gn¹æ je do ³ó¿ka.~
@688 = ~Ale dlaczego... och.~
@689 = ~Chcesz mi powiedzieæ, ¿e nie znasz tego starego krasnoludzkiego dowcipu?~
@690 = ~Do... dowcipu?~
@691 = ~Hrmf. Jeszcze du¿o musisz siê nauczyæ.~
@692 = ~Tiax!~
@693 = ~G³upi œmiertelniku! Œmiesz mi siê opieraæ?~
@694 = ~Puœæ mój topór! Nie bêdê powtarza³! PUŒÆ! GO!~
@695 = ~Wielki Cyric objawi³ mi, ¿e ten *yyyyygh* topór jest darem dla mnie! Sprzeciwiasz siê woli wielkiego *sapie* Cyrica?~
@696 = ~Nie bêdê siê powtarza³. Wielki Tiax zaraz zarobi w zêby, jeœli natychmiast nie puœci mojego topora!~
@697 = ~Niegodny! Nie sprzeciwiaj siê wybrañcowi Cyrica, bo po¿a³ujesz! Wielki Tiax bêdzie z rozkosz¹ patrzy³ na twoje cierpienie, gdy tylko otrzyma to, co mu siê nale¿y!~
@698 = ~Wielki Tiax zaraz otrzyma to, co mu siê nale¿y, o tutaj!~
@699 = ~*uderza piêœci¹*~
@700 = ~Aaach! On uderzy³ Tiaxa! Uderzy³ potê¿nego Tiaxa! Oooch, przeklêta bestio! Za to Tiax... Tiax... Tiax siê wycofa i przemyœli odpowiedni¹ karê, a ty od³ó¿ ten topór, proszê.~
@701 = ~I tak ma zostaæ, bo inaczej dostaniesz kolejny prezent od wielkiego Breagara. Buzzurk!~
@702 = ~Niech to szlag! Viconio! Dlaczego wszystkie buk³aki s¹ puste?~
@703 = ~Za ka¿dym razem, gdy tak wrzeszczysz, mam nadziejê, ¿e jakiœ ma³y owad wpadnie ci do gard³a i zdechnie od twojego nieœwie¿ego oddechu.~
@704 = ~Nape³nianie buk³aków by³o twoim psim obowi¹zkiem, a ty go nie dope³ni³aœ!~
@705 = ~Oczywiœcie, zwal wszystko na drowa, co?~
@706 = ~Kto zapomnia³ nabraæ wody? Viconia.~
@707 = ~Kto kopn¹³ tego urokliwego szczeniaka? Viconia!~
@708 = ~Kto wsypa³ za du¿o soli do zupy? Viconia, rzecz jasna! Mêczysz mnie, Breagarze!~
@709 = ~Ale zupa faktycznie by³a przesolona. Kucharka z ciebie marna. A co do tego szczeniaka...~
@710 = ~Och, po prostu siê zamknij. Usstan phlith dos.~
@711 = ~Tiax... Zupe³nie nie potrafiê zrozumieæ dlaczego nasz przyjaciel <CHARNAME> postanowi³ ci¹gn¹æ ciê ze sob¹, ale nie mam zamiaru podwa¿aæ jego decyzji. Radzê ci jednak, ¿ebyœ wróci³ na miejsce i przesta³ grzebaæ w moich rzeczach, bo przysiêgam na topór Clangeddina, ¿e znów ciê rypnê!~ ~Tiax... Zupe³nie nie potrafiê zrozumieæ dlaczego nasza przyjació³ka <CHARNAME> postanowi³a ci¹gn¹æ ciê ze sob¹, ale nie mam zamiaru podwa¿aæ jej decyzji. Radzê ci jednak, ¿ebyœ wróci³ na miejsce i przesta³ grzebaæ w moich rzeczach, bo przysiêgam na topór Clangeddina, ¿e znów ciê rypnê!~
@712 = ~Nêdzny œmiertelniku! Nie rozumiesz zaszczytu, jaki ciê spotka³? Potê¿ny Tiax szuka wata¿ków, którzy poprowadz¹ jego krucjatê przeciwko krainom i jest gotów wzi¹æ ciê pod uwagê!~
@713 = ~O, doprawdy? Zak³adam, ¿e by³bym wtedy pod twoj¹ komend¹?~
@714 = ~Któ¿ inny ni¿ potê¿ny Tiax móg³by poci¹gaæ za sznurki w tak wielkim przedsiêwziêciu?~
@715 = ~I mniemam, ¿e musia³bym zostaæ gorliwym wyznawc¹ potê¿nego Cyrica?~
@716 = ~Tak, taaaak, TAK! Czujesz, jak sama ta myœl sprawia, ¿e krew w tobie wrze?~
@717 = ~O tak, czujê to wyraŸnie. I chcê ci powiedzieæ coœ jeszcze, podejdŸ bli¿ej.~
@718 = ~Och, co to takiego? Tajemnica tylko dla uszu wielkiego Tiaxa, któr¹ nale¿y zachowaæ przed jego wrogami?~
@719 = ~NATYCHMIAST WRACAJ NA MIEJSCE, ALBO SAM CIÊ TAM WYKOPIÊ! I JEŒLI KIEDYKOLWIEK ZBLI¯YSZ SIÊ DO MNIE ZA BLISKO, TO DOSTANIESZ BÊCKI! BORASCHALVENNURZAH!~
@720 = ~Œmiesz wrzeszczeæ na potê¿nego Tiaxa? Och, sp³oniesz za to! Sp³oniesz! A teraz puœæ mnie, bym móg³ przemyœleæ twoje piekielne mêki w bezpiecznej odleg³oœci.~
@721 = ~W koñcu skrêcisz sobie kark, jeœli dalej bêdziesz próbowa³a zagl¹daæ za w³asne plecy, Aerie.~
@722 = ~Ja... ja wiem. Ale skoro ich nie widzê, to... mam wra¿enie, ¿e moje blizny wygl¹daj¹ coraz gorzej.~
@723 = ~Phi, blizny. Blizny wcale nie sprawiaj¹, ¿e kobieta staje siê brzydka.~
@724 = ~Wiêc... uwa¿asz, ¿e jestem ³adna?~
@725 = ~Hrmf. Nie.~
@726 = ~Och, wiedzia³am! Dlaczego mówisz takie rzeczy, skoro wcale tak nie uwa¿asz? Ty nêdzny...~
@727 = ~Do diab³a, dziewczyno! WeŸ siê w garœæ! Czy ty w ogóle kiedykolwiek widzia³aœ krasnoludzk¹ kobietê?~
@728 = ~Krasnoludkê? Chyba nie. Dlaczego pytasz?~
@729 = ~Niem¹dra dziewucha. Jesteœ zbyt wysoka, zbyt chuda, nie masz brody, a te twoje maœlane oczy nie zadzia³aj¹ na krasnoluda. Jeœli chcesz wiedzieæ, czy jesteœ ³adna, musisz zapytaæ kogoœ innego.~
@730 = ~Ty... nie wspomnia³eœ nic o moich bliznach?~
@731 = ~A po co? Dziewczyno, twoje blizny nic a nic mnie nie obchodz¹.~
@732 = ~...i tak oto Gotrik Bardormar oraz ostatni ocalali z jego klanu za³o¿yli klan Bardormar w górach Burzowych Rogów, gdzie ¿yliœmy szczêœliwie przez ostatnie tysi¹c lat.~
@733 = ~Znasz historiê swojego klanu tak dobrze, jak w³asn¹. Zaskakujesz mnie, Breagarze.~
@734 = ~Dziewczyno, czy ty naprawdê myœlisz, ¿e krasnoludy to tylko zakute w stal, wymachuj¹ce toporami berserki? Spójrz na mnie, czy ja tak wygl¹dam?~
@735 = ~Có¿...~
@736 = ~Phi. U nas w domu ka¿dy zna historiê klanu na pamiêæ. To ona pokazuje nam, kim jesteœmy.~
@737 = ~To brzmi znajomo. Przez ca³e ¿ycie ludzie próbowali mnie oceniaæ wy³¹cznie przez pryzmat mojego nazwiska...~
@738 = ~Krasnoluda nigdy nie ocenia siê „wy³¹cznie” przez pryzmat nazwiska. Nosimy je z dum¹, a ka¿de imiê ma swoje znaczenie.~
@739 = ~Naprawdê? Co zatem oznacza „Breagar”?~
@740 = ~To... *kaszle*... trudne do przet³umaczenia. Nie zrozumia³abyœ.~
@741 = ~No ju¿, nie stój tak, niem¹dra dziewczyno. Ruszajmy dalej.~
@742 = ~Hej! Gdzie pchasz te ³apy, drowko! Trzymaj je tak, ¿ebym móg³ je widzieæ!~
@743 = ~Oczywiœcie, Breagarze. Patrzcie i podziwiajcie – oto zabójcza chusteczka!~
@744 = ~<CHARNAME>... Wykaza³eœ siê odwag¹, kiedy, zaproponowa³eœ mi, ¿e mogê bezpiecznie podró¿owaæ w twojej grupie. Widaæ jednak, ¿e i tutaj czyha na mnie zagro¿enie.~ ~<CHARNAME>... Wykaza³aœ siê odwag¹, kiedy, zaproponowa³aœ mi, ¿e mogê bezpiecznie podró¿owaæ w twojej grupie. Widaæ jednak, ¿e i tutaj czyha na mnie zagro¿enie.~
@745 = ~Och, tak s¹dzisz? Aleœ ty pojêtna.~
@746 = ~Nie myœl, ¿e ciê nie s³ysza³am, krasnoludzie. Prêdzej czy póŸniej za wszystko zap³acisz.~
@747 = ~Phi! Nie zastraszysz mnie, drowko. Twoje b³yskaj¹ce œlepia mog¹ przera¿aæ ludzi albo elfy, ale nie zrobi¹ wra¿enia na prawym krasnoludzie!~
@748 = ~Przejrza³em wasze plemiê na wylot i na topór Clangeddina – zrób tylko jeden b³¹d, a roz³upiê ci czaszkê!~
@749 = ~Spróbuj tylko, a po¿a³ujesz!~
@750 = ~Musi ciê to nieŸle bawiæ, co?~
@751 = ~Zawsze jesteœ taki zrzêdliwy, Breagarze. Nigdy nie widzia³am, ¿ebyœ siê uœmiecha³!~
@752 = ~Mo¿e powinnaœ przyjrzeæ siê uwa¿niej, dziewczyno.~
@753 = ~No to patrzê! Uœmiechnij siê!~
@754 = ~A niby dlaczego? Nie ma tu nic, co by mnie bawi³o.~
@755 = ~Tak tylko dla mnie, co? Prooooooszê.~
@756 = ~Hrmf. Dobra.~
@757 = ~Mo¿e byæ?~
@758 = ~To ma byæ uœmiech? Breagar, stary, musimy nad tym popracowaæ. Wygl¹dasz, jakbyœ po³kn¹³ œmierdz¹cego pluskwiaka.~
@759 = ~*wzdycha*~
@760 = ~Minscu? Mo¿esz mi to wyjaœniæ?~
@761 = ~Minsc nie jest dobry w wyjaœnianiu rzeczy, ale jeœli Breagar lubi Boo, to móg³by...~
@762 = ~O, dasz sobie radê. Co to jest?~
@763 = ~Te ma³e, ciemne coœ w twoim plecaku? Wygl¹da jak rodzynki. Minsc kiedyœ...~
@764 = ~Minscu? To nie s¹ rodzynki. To chomikowe bobki.~
@765 = ~Czy mo¿esz mi wyjaœniæ, dlaczego twój chomik u¿ywa mojego plecaka jako prywatnej toalety?~
@766 = ~To dobre pytanie. Boo, wyt³umacz siê!~
@767 = ~*piip?*~ [GAM_48]
@768 = ~Boo mówi, ¿e twój plecak œmierdzia³ tak, jakby kilka chomików ju¿ siê w nim za³atwi³o, wiêc pomyœla³, ¿e...~
@769 = ~Wygl¹dasz, jakbyœ chcia³ coœ z siebie wyrzuciæ, Ajantisie.~
@770 = ~Có¿, to prawda. Mo¿emy chwilê porozmawiaæ, Breagarze?~
@771 = ~O co chodzi, paladynie?~
@772 = ~Mo¿e... mo¿e to zostaæ miêdzy nami?~
@773 = ~Hrmm? Coœ ciê gryzie?~
@774 = ~Nie chodzi o mnie, tylko o ciebie.~
@775 = ~O mnie? Nie mam nic do ukrycia. Dalej, wykrztuœ to, Ajantisie!~
@776 = ~Có¿... zauwa¿y³em, ¿e ty... em, du¿o pijesz, Breagarze.~
@777 = ~Przecie¿ ca³y czas jesteœmy w drodze, Ajantisie. Od czasu do czasu muszê siê porz¹dnie napiæ.~
@778 = ~Oczywiœcie, ale nie o to dok³adnie mi chodzi³o.~
@779 = ~Widzisz, alkohol... pity z umiarem jest w porz¹dku, ale...~
@780 = ~Czego, na wszystkie demony Otch³ani, ty ode mnie chcesz, Ajantisie? Widzisz, ¿eby trzês³y mi siê rêce? S³yszysz, bym be³kota³? Rozmawiasz z krasnoludem, nie z jakimœ mizernym elfem czy cz³owiekiem, któremu oczy zachodz¹ mg³¹ od samego zapachu s³odu!~
@781 = ~Em...~
@782 = ~Zachowaj swoje kazania dla kogoœ, kto ich potrzebuje, paladynie.~
@783 = ~Moje „kazania” s¹ dla tych, którzy b³¹dz¹ w oczach Czujnego. Niebawem siê o tym przekonasz.~
@784 = ~Hrmf... Chce pouczaæ krasnoluda o piciu piwa... ludzie... Buzzurk!~
@785 = ~Czego ode mnie chcesz, Korganie?~
@786 = ~O, po prostu jestem ciekawy, kowalu. Dawno nie widzia³em krasnoluda z g³êbin.~
@787 = ~Jeœli nie szukasz zwady, lepiej dobieraj kolejne s³owa ostro¿nie.~
@788 = ~Eeee, o co te fochy? Jesteœ z tych z do³u, nie? Œwie¿o wype³z³eœ spod skrzyde³ swego klanu, gdzie spêdza³eœ ca³e dnie siedz¹c i pewnie wsadzaj¹c ³eb do pieca?~
@789 = ~Buzzurk! Nie masz pojêcia, o czym gadasz! Jak dawno temu opuœci³eœ swój klan? A mo¿e to oni ciê wykopali, Korganie?~
@790 = ~Dawno to by³o, doœæ czasu by poj¹æ, jakie to nudne i gówniane ¿ycie. Na powierzchni rozpêta³o siê piek³o, ty te¿ to w koñcu zrozumiesz.~
@791 = ~Uwierz mi, ju¿ to zrozumia³em.~
@792 = ~Mo¿emy chwilê porozmawiaæ, Keldornie?~
@793 = ~Co ciê trapi?~
@794 = ~Zastanawiam siê, dlaczego cz³owiek taki jak ty nie jest przy ¿onie i dziecku. Czy bycie z rodzin¹ nie jest obowi¹zkiem ka¿dego mê¿czyzny?~
@795 = ~Mówisz prawdê, ale ja pod¹¿am za wezwaniem mojego boga.~
@796 = ~Musi to byæ bezduszny bóg, skoro wystawia ciê na tak¹ próbê.~
@797 = ~Tak s¹dzisz? Có¿, Breagarze... Dlaczego ty nie jesteœ w domu ze swoj¹ rodzin¹?~
@798 = ~Phi, wróci³bym w te pêdy, gdyby nie...~
@799 = ~Widzisz? Nasze œcie¿ki s¹ do siebie bardzo podobne, przyjacielu.~
@800 = ~O co chodzi z tym durnym uœmiechem, drowko?~
@801 = ~Chyba powinnam doceniæ, ¿e nie spuszczasz mnie z oka, Breagarze. To powstrzymuje innych przed podkradaniem siê i wbijaniem mi no¿a w plecy.~
@802 = ~Nie myœl sobie, ¿e kiwnê choæ palcem, by chroniæ ciê w walce.~
@803 = ~O, ale¿ w³aœnie tak myœlê. Wiesz doskonale, ¿e ta dru¿yna odniesie sukces tylko wtedy, gdy ka¿dy odegra swoj¹ rolê. Przyzwyczaj siê wiêc do myœli, ¿e nie tylko oszczêdzisz TÊ drowkê, ale bêdziesz JEJ broni³ w boju.~
@804 = ~Lepiej sobie wybij z g³owy te swoje fantazje – od prawdy dzieli je przepaœæ. Bêdziesz trzymana krótko na smyczy i ruszysz do walki tylko wtedy, gdy padnie rozkaz.~
@805 = ~Dobrze. Pytaj, Jansenie.~
@806 = ~Pytaæ? A nie przysz³o ci do g³owy, ¿e to TY chcia³eœ mnie o coœ zapytaæ? Czy¿byœ nas pomyli³?~
@807 = ~Znam to spojrzenie. Interesuje ciê moja srebrna rêka i...~
@808 = ~Srebrna? Có¿ za rozczarowanie. By³em przekonany, ¿e z mithrilu – jak rêka mojego wujcia Wernera.~
@809 = ~Twój wuj mia³ rêkê z mithrilu? Mam w to niby uwierzyæ?~
@810 = ~Werner Jansen by³ znakomitym m³ynarzem. Najlepsza m¹ka w ca³ym Amn! A¿ pewnego dnia rêkaw wkrêci³ mu siê w tryby m³yna i... no có¿. Trzask!~
@811 = ~Trzask?~
@812 = ~Trzask.~
@813 = ~Rêkawa brak, a rêka, która by³a w œrodku, nie wygl¹da³a ju¿ najlepiej. Na szczêœcie trafi³ siê krasnoludzki kowal, który dzieñ wczeœniej zajada³ siê chlebem wuja. A ¿e akurat mia³ przy sobie bry³ê mithrilu... Jak lepiej podziêkowaæ za dobry bochen?~
@814 = ~Nadal próbujesz mi wmówiæ, ¿e to prawda?~
@815 = ~To jeszcze nic przy tym, co dosta³ za m¹kê sprzedan¹ tamtego dnia. „Dzieñ Czerwonej M¹ki”, jak to potem nazwano, by³...~
@816 = ~Sprzeda³ tê m¹kê?! Z krwi¹ i koœæmi?~
@817 = ~Powinieneœ spróbowaæ chleba, który z niej upiekli. Istna ambrozja!~
@818 = ~Jesteœ jeszcze bardziej szalony ni¿ wiêkszoœæ powierzchniowców. Trzymaj siê ode mnie z daleka.~
@819 = ~<CHARNAME>... Te niekoñcz¹ce siê lasy dzia³aj¹ mi na nerwy. Mo¿emy odpocz¹æ w najbli¿szej karczmie?~
@820 = ~Popieram Breagara, <CHARNAME>. Przerwa dobrze nam wszystkim zrobi.~
@821 = ~Zw³aszcza ¿e dno w moim piwnym buk³aku ju¿ przeœwituje.~
@822 = ~Nie chcia³bym ciê pouczaæ, Breagarze, ale myœlê, ¿e ca³ej grupie wysz³oby na zdrowie, gdybyœ zacz¹³ nosiæ w buk³aku wodê zamiast... alkoholu.~
@823 = ~Och, znowu zaczynasz? Wodê? Phi! Przecie¿ wiesz, co ryby i ¿aby wyprawiaj¹ w tej wodzie, prawda?~
@824 = ~Woda zapewnia trzeŸwoœæ umys³u, Breagarze. Z³o nie œpi i musimy byæ w ci¹g³ej gotowoœci.~
@825 = ~Przecie¿ ja JESTEM gotowy, paladynie!~
@826 = ~Na Helma, miejmy nadziejê, ¿e tak ju¿ zostanie!~
@827 = ~Masz chwilê?~
@828 = ~Och, dla ciebie zawsze, ale ten wróbel...~
@829 = ~Ten wróbel zaraz tu przylezie, albo mu oskubiê pióra!~
@830 = ~Tym razem mi nie uciekniesz.~
@831 = ~Có¿, gdy z³y pies pokazuje k³y, ptaszek uwa¿niej s³ucha. W czym mogê pomóc?~
@832 = ~Tym razem mnie wys³uchasz. Bez przerywania.~
@833 = ~Œwiat, jaki znamy, zosta³ wykuty rêk¹ kowala œwiata. Boskie arcydzie³o, w którym wszystko ma swoje miejsce.~
@834 = ~I mamy siê cieszyæ, ¿e to wszystko powoli siê rozpada?~
@835 = ~Entropia jest nieunikniona, mój uparty przyjacielu. Mo¿esz z ni¹ walczyæ, mo¿esz siê ni¹ zadrêczaæ – nic to nie zmieni.~
@836 = ~To nie znaczy jednak, ¿e muszê siê z tym godziæ!~
@837 = ~A któ¿ odwa¿y³by siê mówiæ ci, co masz robiæ.~
@838 = ~Przestañ mnie uspokajaæ! Buzzurk, ja po prostu...~
@839 = ~<CHARNAME>? Oczywiœcie, ¿e ciê s³yszê! Ten wróbel ju¿ leci!~
@840 = ~Ale <CHARNAME> ciê nie wo³... ej! Zostañ tu!~
@841 = ~No proszê. Teraz ju¿ nie uciekniesz.~
@842 = ~Znów masz delikatne skrzyd³a ptaszka w zêbach, mój drogi terierze? Uwa¿aj, ¿eby ich nie odgryŸæ.~
@843 = ~Przestañ mnie tak nazywaæ, diabelstwo! Nie jestem ¿adnym psem!~
@844 = ~Nie? A wiêc jak mam siê do ciebie zwracaæ?~
@845 = ~Tak, jak wszyscy inni.~
@846 = ~Nie u³atwiasz mi tego, przyjacielu. S³ysza³em ju¿ wiele imion, którymi ciê okreœlano.~
@847 = ~Naprawdê?~
@848 = ~Owszem. Choæ Breagar s³yszy siê najczêœciej, to równie czêsto s³yszê „ten kurdupel” albo „uparty ma³y bêkart”. Jeœli wiêc pozwolisz, ja bym...~
@849 = ~Ty nic nie bêdziesz! Buzzurk! Jeœli potrzebujesz jakiegoœ imienia, to sam je sobie wybiorê.~
@850 = ~Skoro tak chcesz. Pomyœl nad nim, a gdy ju¿ je znajdziesz, powiedz mi.~
@851 = ~Powiem, na bogów!~
@852 = ~Namyœla³em siê wystarczaj¹co d³ugo, Haer’Dalisie.~
@853 = ~Doprawdy? Jak mam ciê zatem nazywaæ, mój bezimienny przyjacielu?~
@854 = ~Wybra³em „Orze³”.~
@855 = ~I jesteœ... pewien?~
@856 = ~A czemu mia³bym nie byæ, g³upie diabelstwo? Or³y ¿yj¹ w górach, jak ja. Bystre oczy, czujne uszy, ostre szpony – jak ja.~
@857 = ~Prawda. Zatem od dziœ bêdziesz Or³em – ptakiem, który kocha lot nad otwartym niebem, s³oñce na piórach i...~
@858 = ~Czekaj, czekaj. Chyba za szybko to powiedzia³em. Latanie, s³oñce, otwarte niebo... to nie brzmi dobrze.~
@859 = ~Spokojnie, przyjacielu. Pozwól, ¿e ci pomogê. S³owa s¹ mi pos³uszne – przychodz¹, gdy je wzywam. O czym myœlisz?~
@860 = ~Hrmf. Wytrwa³y, twardo st¹paj¹cy po ziemi, wierny...~
@861 = ~Jak... hmm... terier?~
@862 = ~O tak! Dok³adnie! Buzzurk! Czemuœ tak to rozwleka³?!~
@863 = ~Zapewniam ciê, ¿e wiêcej tego b³êdu nie pope³niê.~
@864 = ~No co znowu?~
@865 = ~Zaspokój moj¹ ciekawoœæ, Breagarze. Jak to jest byæ zwyk³ym pionkiem w rêkach bogów?~
@866 = ~Pionkiem? Phi. Nie masz pojêcia, o czym mówisz.~
@867 = ~Owszem, mam. Otrzyma³eœ od bogów dar, ale te¿ warunek, ¿e bêdziesz z niego korzysta³ na ich zasadach.~
@868 = ~Teraz trzymaj¹ ciê na krótkiej smyczy, a ty wykonujesz ka¿de polecenie niczym pies boj¹cy siê kopniaka.~
@869 = ~O, tak to widzisz? I mówi to ktoœ taki jak ty? Twoi ludzie istniej¹ tylko po to, by dogadzaæ tej waszej przeklêtej Lolth! Phi.~
@870 = ~Jesteœ idiot¹, Breagarze. Dawno temu wyrzek³am siê Pajêczej Królowej. Nie zamierzam jednak obci¹¿aæ ciê szczegó³ami, których i tak nie pojmiesz. Po prostu stój miêdzy mn¹ a wrogiem. Kto wie, mo¿e pewnego dnia uleczê twoje rany w nagrodê za dobre sprawowanie.~
@871 = ~Nie udawaj, ¿e to od twojej decyzji zale¿y, kogo leczysz. Pomnij w³asne s³owa – ta grupa odniesie sukces tylko wtedy, gdy ka¿dy bêdzie zna³ swoje miejsce.~
@872 = ~Mo¿e wiêc zostaniesz z ty³u i rzucisz paroma kamieniami... albo dla odmiany ugotujesz obiad. Nigdy nie widzia³em ciê przy garnkach.~
@873 = ~I nigdy nie zobaczysz, ty plugawa szumowino! Takie zajêcia s¹ poni¿ej mojej godnoœci.~
@874 = ~Skoro tak twierdzisz...~
@875 = ~Powiedz mi, Branwen, czy to prawda, ¿e u twojego ludu nie mog³aœ zostaæ kap³ank¹, bo waszymi kap³anami zazwyczaj s¹ mê¿czyŸni?~
@876 = ~Nie zazwyczaj, Breagarze. Wy³¹cznie.~
@877 = ~Hm. Czy wasi mê¿czyŸni s¹ pobo¿niejsi od kobiet?~
@878 = ~*œmieje siê* Nie, ani trochê.~
@879 = ~Wiêc dlaczego kobiety nie mog¹ zostawaæ kap³ankami? Nie rozumiem.~
@880 = ~Czy twój lud a¿ tak bardzo siê ró¿ni pod tym wzglêdem?~
@881 = ~S¹ zawody czêœciej wybierane przez kobiety i takie, które s¹ niemal wy³¹cznie domen¹ mê¿czyzn. Ale w wiêkszoœci przypadków ta ma³a ró¿nica nie ma ¿adnego znaczenia.~
@882 = ~Wasze kobiety musz¹ byæ szczêœliwe. Mój lud ma bardzo sztywne pogl¹dy na temat niewiast, które chc¹ chwyciæ za broñ.~
@883 = ~My te¿! Oczekujemy od nich, ¿e bêd¹ DOBRZE walczyæ! To w koñcu krasnoludy!~
@884 = ~*wzdycha* Chcia³abym byæ krasnoludem.~
@885 = ~Jeœli mogê w czymœ pomóc...~
@886 = ~Jak to jest z tymi pucharami, o które wy, paladyni, tak dbacie? Dlaczego s¹ dla was a¿ tak wa¿ne?~
@887 = ~Puchar symbolizuje wiêŸ miêdzy paladynem a zakonem. Dlaczego pytasz?~
@888 = ~To akurat wiem, ale dlaczego puchar? Dlaczego nie miecz, zbroja albo chocia¿ sztylet? To s¹ symbole, które bym zrozumia³.~
@889 = ~Jesteœmy kimœ wiêcej ni¿ tylko zbrojnym ramieniem bogów, Breagarze. Zakon jest centrum naszego ¿ycia, nasz¹ opok¹ i pokojem.~
@890 = ~A puchar jest symbolem ¿ycia – tego, co daje pocz¹tek ¿yciu na tym œwiecie.~
@891 = ~Hrmf. Jedyne, co przychodzi mi do g³owy, co daje ¿ycie i wygl¹da trochê jak puchar, to kobiece...~
@892 = ~*odchrz¹ka*~
@893 = ~Gratulujê, Breagarze. Wiêkszoœci nowicjuszy zrozumienie tego powi¹zania zajmuje znacznie wiêcej czasu.~
@894 = ~Co? Jakiego powi¹zania?~
@895 = ~Em... wyjaœnimy ci to innym razem, Anomenie.~
@896 = ~Kto to by³?~
@897 = ~Co? Kto co? Czy w pobli¿u s¹ jakieœ ³otry? Czy to czas na kolejne kopanie ty³ków?~
@898 = ~O tak, zdecydowanie! Buzzurk! Któryœ z was, g³upcy, mia³ czelnoœæ dobieraæ siê do moich zapasów piwa! Kto to by³?~
@899 = ~Ach, Minsc mo¿e to wyjaœniæ.~
@900 = ~Ty? Ty wypi³eœ moje piwo?~
@901 = ~Widzisz, Boo bardzo ciê polubi³ i podczas naszego ostatniego postoju zastanawia³ siê, czy jego upodobanie do piwa bêdzie wspó³gra³o z twoim.~
@902 = ~Wiêc spróbowa³ kropelkê.~
@903 = ~Minscu... na bosk¹ mi³oœæ i wszystko, co ci drogie. POWIEDZ MI, ¯E TO NIEPRAWDA! DA£EŒ SWOJEMU CHOMIKOWI PIÆ PIWO? Z MOICH ZAPASÓW? KIEDY SPA£EM?~
@904 = ~Dok³adnie tak zrobi³em. I nie martw siê, Boo uzna³, ¿e bardzo mu smakowa³o.~
@905 = ~DO DIAB£A! BUK£AK JEST W PO£OWIE PUSTY!~
@906 = ~Có¿, widzisz, Boo chcia³ zasiêgn¹æ drugiej opinii, wiêc ja...~
@907 = ~Szaleñcy! Wszyscy jesteœcie szaleni! Buzzurk!~
@908 = ~Ajantisie? Myœlê, ¿e mia³eœ racjê.~
@909 = ~Mia³em racjê? W jakiej kwestii, Breagarze?~
@910 = ~W tej, ¿e noszenie ze sob¹ zapasu piwa to wcale nie by³ dobry pomys³.~
@911 = ~Breagarze! Zdumiewasz mnie.~
@912 = ~Och, to ca³kiem rozs¹dne, jeœli siê nad tym zastanowiæ.~
@913 = ~I ty siê nad tym zastanowi³eœ?~
@914 = ~Owszem, zastanowi³em.~
@915 = ~W skórzanym buk³aku piwo strasznie szybko wietrzeje. Przy nastêpnej okazji nape³niê go miodem pitnym.~
@916 = ~Breagarze! Nie o to mi chodz...~
@917 = ~Ech, mniejsza z tym. Pewnie ³atwiej by³oby wspi¹æ siê na wodospad, ni¿ odci¹gn¹æ krasnoluda od picia.~
@918 = ~O co znowu chodzi, dziewczyno?~
@919 = ~Myœlê, ¿e znalaz³am rozwi¹zanie twojego problemu.~
@920 = ~No weŸ. Chcê tylko pomóc!~
@921 = ~Do tej pory nawet nie wiedzia³em, ¿e potrzebujê pomocy.~
@922 = ~Dobra, s³uchaj. Ork, elf i gibberling wchodz¹ do karczmy. Gibberling podchodzi do elfa i mówi...~
@923 = ~Ale po co?~
@924 = ~Em, co?~
@925 = ~Po co ork, elf i gibberling mieliby siê tak spotykaæ? To nie ma sensu. Ork zmia¿d¿y³by gibberlinga, wzi¹³ jego œmierdz¹ce truch³o i zat³uk³by nim elfa na œmieræ.~
@926 = ~I to ma mnie œmieszyæ? Phi!~
@927 = ~To nie jest zabawne, tylko obrzydliwe. WyobraŸ sobie tylko – gibberling w karczmie. Marnowanie dobrego piwa na orka...~
@928 = ~Wiesz co, Breagarze... mo¿e powinieneœ poæwiczyæ to ca³e uœmiechanie siê gdzieœ w samotnoœci, ¿eby nikt nie widzia³.~
@929 = ~Minscu? Musimy porozmawiaæ.~
@930 = ~Ojej! Tê sam¹ minê zawsze robi³a Dynaheir, kiedy nabroi³em.~
@931 = ~Dobrze siê spisujesz, mój przyjacielu, i zawsze chêtnie walczê u twego boku, ale mo¿e móg³byœ byæ odrobinê mniej narwany?~
@932 = ~Kiedy z³o pokazuje sw¹ brzydk¹ twarz, nic nie powstrzyma Minsca i Boo!~
@933 = ~Tak, zauwa¿y³em. Jak dot¹d osiem razy mnie przewróci³eœ, a trzy razy zamierzy³eœ siê na mnie broni¹.~
@934 = ~Naprawdê? Có¿, mo¿e nie powinieneœ warczeæ i mamrotaæ pod nosem przez ca³y czas. W ferworze walki trudno ciê odró¿niæ od z³oczyñcy.~
@935 = ~Co? To jest... tak, ¿e... och, wiesz co? Od teraz w walce bêdê siê trzyma³ od ciebie z daleka. To bêdzie prostsze ni¿ próba dotarcia do tego twojego niewielkiego rozumku.~
@936 = ~Coœ siê sta³o, Ajantisie?~
@937 = ~Chcia³em tylko powiedzieæ, ¿e zazdroszczê ci, Breagarze.~
@938 = ~Nie doœæ, ¿e sami bogowie powierzyli ci zadanie, to jeszcze hojnie ciê za nie wynagrodzili.~
@939 = ~Nie rób takiej miny! Czy myœl o byciu b³ogos³awionym nie sprawia ci ¿adnej radoœci?~
@940 = ~Czujê siê zaszczycony, Ajantisie. I zrobiê wszystko, co w mojej mocy, by dowieœæ, ¿e jestem tego wart. Ale czy czujê radoœæ?~
@941 = ~Moj¹ radoœæ mi odebrano.~
@942 = ~Cierpliwoœci, Breagarze. Gdy bogowie raz siê tob¹ zainteresuj¹, ju¿ zawsze bêdziesz czu³ ich prowadz¹c¹ d³oñ.~
@943 = ~W³aœnie tego siê obawiam, paladynie.~
@944 = ~Nie jestem taki jak ty. Nie szukam poklasku ani chwa³y na polu bitwy – ani dla siebie, ani dla moich bogów.~
@945 = ~O nic z tych rzeczy nie prosi³em. Gdybym tylko móg³ zamieniæ to ca³e „wspania³e” ¿ycie na skromny, spokojny ¿ywot, zrobi³bym to bez mrugniêcia okiem.~
@946 = ~Przyjmij swój los ze spokojem, kowalu. Kiedy wszystko dobiegnie koñca, zobaczysz, ¿e sprawy u³o¿¹ siê po twojej myœli.~
@947 = ~Miejmy nadziejê, ¿e masz racjê, Ajantisie. Taa, miejmy nadziejê.~
@948 = ~Wiesz co, Branwen? By³aby z ciebie œwietna kap³anka Clangeddina. Twoja odwaga w walce jest godna naœladowania.~
@949 = ~Dziêkujê, Breagarze. Nic tak nie przynosi chwa³y bogom, jak porz¹dna bitwa.~
@950 = ~O tak, masz...~
@951 = ~DŸwiêk pêkaj¹cych koœci, jêki i krzyki rannych, krakanie kruków...~
@952 = ~Em, chyba pójdê...~
@953 = ~Zapach spalenizny i krwi w powietrzu, widok wrogów tratowanych w py³, ta radoœæ, gdy rozpruwasz im brzuchy i...~
@954 = ~Dobra, wystarczy!~
@955 = ~Buzzurk. Muszê jednak jeszcze raz przemyœleæ to twoje kap³añstwo u Clangeddina...~
@956 = ~Nie owijasz w bawe³nê, co, Branwen? Istnieje choæ jedna myœl, której ba³abyœ siê wypowiedzieæ na g³os?~
@957 = ~Dlaczego mia³abym kryæ swoje myœli? Tempus naucza uczciwoœci i szczeroœci.~
@958 = ~Szczeroœci? To niby dobrze, ale ty jesteœ... nad wyraz szczera, kap³anko.~
@959 = ~Czy moje s³owa ciê obra¿aj¹? Wykrztuœ to.~
@960 = ~Dziêki, ale wiem doskonale, jak Tempus rozwi¹zuje spory. Odpuszczê sobie.~
@961 = ~Mo¿e po prostu zastanów siê, czy czasem nie jesteœ odrobinê zbyt wylewna.~
@962 = ~Zawsze jestem gotowa poprzeæ swoje s³owa czynami.~
@963 = ~Masz chwilê, Minscu?~
@964 = ~Oczywiœcie, przyjacielu! Jak Minsc i Boo mog¹ ci pomóc?~
@965 = ~Zdajesz siê ca³kiem nieŸle radziæ sobie ze strat¹ swej wiedŸmy. Czy twe serce nie op³akuje ju¿ Dynaheir?~
@966 = ~Serca Minsca i Boo wci¹¿ krwawi¹, mój przyjacielu. Nawet jeœli tego nie widzisz, chomik taki jak Boo wie, ¿e z³o nigdy nie œpi – jest czas na ¿a³obê i jest czas na kopanie ty³ków!~
@967 = ~Chyba ciê rozumiem. Zaimponowa³eœ mi, Minscu.~
@968 = ~Ha! S³yszysz to, Boo? Minsc mu zaimponowa³! Tak, ty oczywiœcie te¿. Nasz przyjaciel Breagar jest doœæ m¹dry, by rozpoznaæ chomika godnego podziwu.~
@969 = ~Nie da siê ciebie pozbyæ, co, Aloro?~
@970 = ~Nie da. Ale nie rozumiem, dlaczego nie potrafisz siê cieszyæ. Masz srebrn¹ rêkê, magiczn¹ zbrojê, gromadkê przyjació³. Czy to wszystko nie sprawia, ¿e jesteœ choæ odrobinê szczêœliwy?~
@971 = ~A dlaczego mia³bym nie byæ? Oczywiœcie, ¿e jestem. Ruszajmy ju¿, niem¹dra dziewczyno.~
@972 = ~Nie, wcale nie jesteœ. Mo¿e i cieszysz siê, ¿e nie podró¿ujesz sam, i pewnie czujesz siê zaszczycony b³ogos³awieñstwem bogów, ale nie jesteœ szczêœliwy.~
@973 = ~Hrmf. No proszê, za t¹ twoj¹ gadatliw¹ buŸk¹ kryje siê jednak bystry umys³.~
@974 = ~Powiedz mi, Aloro, gdyby zabrano ci wszystko, gdyby ka¿de marzenie, na jakie siê kiedykolwiek odwa¿y³aœ, roztrzaskano w drobny mak... by³abyœ szczêœliwa?~
