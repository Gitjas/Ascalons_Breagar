@0   = ~<CHARNAME>! Puœæ to stworzenie wolno, zanim narobi wiêcej szkód, ni¿ ten œwiat jest w stanie znieœæ.~
@1   = ~Rzadko siê zdarza, by przedstawiciel ma³ego ludu stawa³ w obronie mojego rodzaju. Nawet jeœli twoja... argumentacja wydaje mi siê osobliwa.~
@2   = ~Przecie¿ czuæ tu szwindlem na kilometr. O czym ty w ogóle myœla³aœ? Samotny mag mieszkaj¹cy w wie¿y, zaciera ³apy i chichocze pod nosem... no jasne, takiemu na pewno mo¿na ufaæ!~
@3   = ~Teraz siê nie wychylaj, bo zaraz wymieciemy z³o z tej wie¿y!~
@4   = ~Niech bogowie maj¹ ciê w opiece.~
@5   = ~Uwa¿aj, <CHARNAME>. Kto wie, jakie iluzje tu na nas dybi¹!~
@6   = ~Przysiêgam, to prawda! Pomó¿cie mi!~
@7   = ~Co u licha... Co to za czary?~
@8   = ~Takie, które i ciebie dosiêgn¹, jeœli natychmiast nie opuœcisz tego miejsca!~
@9   = ~No jasne. Co jeszcze jest tu niewidzialne? Mo¿e ca³a armia orków?~
@10  = ~B³agam, musisz mi uwierzyæ!~
@11  = ~No to spróbuj!~
@12  = ~Hej, spokojnie, ch³opcze!~
@13  = ~Milcz i poka¿ siê!~
@14  = ~Jeszcze siê taki mag nie urodzi³, co by krasnoludzki topór wytrzyma³. Ba!~
@15  = ~Wiesz, jak sprawiæ, by ciê s³uchano.~
@16  = ~<GABBER> Cudotwórca, wybawca piesków. Ta, jasne.~
@17  = ~Jesteœ niesamowity! Normalnie móg³bym ciê wyca³owaæ!~
@18  = ~Fajnie by³oby mieæ znajomych w gildii kupieckiej. Siedzielibyœmy na ¿yle z³ota.~
@19  = ~Nie martw siê, przyjacielu. Daj mi chwilê, a sprawiê, ¿e <CHARNAME> zmieni zdanie.~
@20  = ~No tak, druid ma przyjació³ wszêdzie, co nie?~
@21  = ~Och, przymknij siê.~
@22  = ~Doœæ gadania, czas na ból!~
@23  = ~Na m³ot Moradina! <CHARNAME>! Musimy coœ zrobiæ! Nie mo¿emy na to pozwoliæ, buzzurk!~
@24  = ~Dobrze powiedziane, kowalu. Na m³ot Moradina!~
@25  = ~My krasnoludy mamy takie powiedzenie, Anomenie. Potrzeba tysi¹ca celnych uderzeñ m³ota, by uformowaæ stal, ale wystarczy jedno chybione, by wszystko zniweczyæ. Widzê, jak boli ciê œmieræ rodziny, ale lepiej uwa¿aj na swój kolejny ruch.~
@26  = ~Ba, magowie, przytu³ki, nawet demony nie robi¹ ju¿ na mnie wra¿enia. Ruszajmy do walki!~
@27  = ~Cieszê siê, ¿e masz takie zdecydowane podejœcie.~
@28  = ~Czekaj... wyspa? Wyspa! Chcesz nas tam zabraæ £ODZI¥? O nie, mój panie! Nie ze mn¹ te numery! Teleportuj nas tam, jeœli musisz, ale prêdzej mi nogi zgnij¹ i odpadn¹, ni¿ postawiê choæby pó³ stopy na statku!~
@29  = ~Chcê siê tylko upewniæ... Jesteœ gotów stawiæ czo³a magom i demonom, ale nie wejdziesz na pok³ad ³odzi?~
@30  = ~Prêdzej wykopiê tunel na tê przeklêt¹ wyspê! Bêdê gryz³ lit¹ ska³ê, jeœli zajdzie potrzeba! Nikt nie zaci¹gnie Breagara na ¿aden statek!~
@31  = ~Có¿, to odrobinê komplikuje sprawê... <CHARNAME>, mo¿e przemówisz przyjacielowi do rozs¹dku?~
@32  = ~Ten durny ch³ystek nie zmieni mojego zdania. ZnajdŸ inny sposób, albo ja zostajê tutaj.~ ~Ta durna dziewucha nie zmieni mojego zdania. ZnajdŸ inny sposób, albo ja zostajê tutaj.~
@33  = ~Breagarze, b¹dŸ rozs¹dny.~
@34  = ~Breagarze, pomyœl o Imoen. Ona potrzebuje naszej pomocy.~
@35  = ~Breagarze, pomyœl o Irenicusie. Chcesz, by nam uciek³?~
@36  = ~Ty prosisz MNIE, ¿ebym by³ rozs¹dny?! Ten... ten... ³otr chce nas zawlec na statek! Na ³ódŸ! Przez ocean! I to ja jestem tu nierozs¹dny? Phi!~
@37  = ~Proszê, Breagarze. Wiesz, ¿e bêdziemy potrzebowaæ twojej pomocy.~
@38  = ~Dobra, skoro chcesz nas porzuciæ...~
@39  = ~Durna, ma³a Imoen! Nic a nic mnie nie obchodzi, czy...~
@40  = ~Ba, pewnie ten sukinsyn i tak nied³ugo znowu siê wy³oni, a wtedy my... my go...~
@41  = ~Zapomnij o tym, ch³ystku! Nawet jak bêdziesz b³agaæ na kolanach, to nie zamierzam...~ ~Zapomnij o tym, dziewucho! Nawet jak bêdziesz b³agaæ na kolanach, to nie zamierzam...~
@42  = ~*wzdycha*~
@43  = ~Przeklêty ch³ystku! Breagar nigdy nikogo nie zostawia w potrzebie!~ ~Przeklêta dziewucho! Breagar nigdy nikogo nie zostawia w potrzebie!~
@44  = ~No dobra, niech stracê. Wchodzimy na ³ajbê, ale powiem ci jedno – jeœli pójdziemy na dno, to osobiœcie ciê zat³ukê, o ile prze¿yjesz!~
@45  = ~Cieszê siê, ¿e poszed³eœ po rozum do g³owy. Nie³atwo by³o znaleŸæ odpowiedniego kapitana.~
@46  = ~Ten przeklêty ³otr najpierw marnuje nasz czas, a teraz chce nas ug³askaæ tymi rupieciami? St¹pasz po cienkim lodzie, ch³opcze!~
@47  = ~Drogi panie, proszê o odrobinê rozs¹dku i wys³uchanie mnie.~
@48  = ~Phi. Worgi. To dla nas ¿aden problem, wrócimy za minutê.~
@49  = ~Och, proszê, poœpieszcie siê!~
@50  = ~Zrób wiêc co w twojej mocy, ch³opcze.~
@51  = ~Nie przypominam sobie, bym zwraca³ siê do ciebie.~
@52  = ~Co to za makabra, <CHARNAME>? Stworzy³ sobie rodzinê z nieumar³ych?~
@53  = ~Nooo, bracie. Czekamy!~
@54  = ~Nie bêdziemy s³uchaæ jakiejœ durnej smarkuli, która mówi nam, dok¹d mamy iœæ!~
@55  = ~Nie przypominam sobie, ¿ebym to z tob¹ rozmawia³a.~
@56  = ~Wrêcz przeciwnie! To problem wielkich rozmiarów! Ju¿ ja ciê nauczê rozumu, ty durna dziewucho!~
@57  = ~*chichocze*~
@58  = ~Nazwa³aœ nas wieœniakami?! Buzzurk! Ja ci poka¿ê, kto tu jest wieœniakiem!~
@59  = ~No dalej, atakujcie!~
@60  = ~Nie jesteœ st¹d?! Na t³usty brzuch Abbathora, to przeklêta drowka! <CHARNAME>! Niech sprawiedliwoœci stanie siê zadoœæ! Zabijmy j¹!~
@61  = ~Nie chcê umieraæ! B³agam!~
@62  = ~Nie wierz w ani jedno s³owo tej ciemnoskórej ladacznicy! Dobrze ci radzê, zabij j¹!~
@63  = ~Nie s³uchaj go! B³agam!~
@64  = ~*Breagar spluwa g³oœno*~
@65  = ~Nie p³awi³abym siê tak w tym poczuciu wy¿szoœci, krasnoludzie. Wiesz doskonale, ¿e twoja rasa te¿ nie jest bez winy.~
@66  = ~Porozmawiamy o tym póŸniej. A ty, Viconio... bêdê ciê mia³ na oku.~
@67  = ~A ja ciebie, hargluk.~
@68  = ~Phi, pó³ogry! Radzenie sobie z tak¹ ho³ot¹ powinno byæ dziecinn¹ igraszk¹ dla paladyna twojego pokroju!~
@69  = ~Nie dobijaj mnie ju¿, panie krasnoludzie, b³agam.~
@70  = ~<CHARNAME>! Nawet palcem nie kiwnê, by s³u¿yæ tej... tej... tej kreaturze! Jeœli siê na to zgodzisz, nasza wspólna podró¿ skoñczy siê tutaj!~
@71  = ~Có¿, <CHARNAME>... Naprawdê chcesz mieæ takich nielojalnych towarzyszy? Nie widzisz, ¿e oferujê ci œwietny uk³ad?~
@72  = ~<CHARNAME>... Wiem, ¿e z ciebie durny ch³ystek, ale chyba nie ufasz tej kobiecie? Jej zepsucie jest obraz¹ dla wszystkich moich zmys³ów! Buzzurk!~ ~<CHARNAME>... Wiem, ¿e z ciebie durna dziewucha, ale chyba nie ufasz tej kobiecie? Jej zepsucie jest obraz¹ dla wszystkich moich zmys³ów! Buzzurk!~
@73  = ~To doprawdy atrakcyjna oferta, ale ka¿da cz¹stka mego cia³a wrêcz krzyczy, by nie pracowaæ dla tej osoby. <CHARNAME>! Nie zgadzaj siê na to!~
@74  = ~A wiêc dobrze, <CHARNAME>. Dokona³eœ wyboru. Niech bogowie wybacz¹ ci twoj¹ g³upotê, bo Breagar z klanu Bardormar tego nie zrobi. Módl siê, by nasze œcie¿ki nigdy wiêcej siê nie przeciê³y.~ ~A wiêc dobrze, <CHARNAME>. Dokona³aœ wyboru. Niech bogowie wybacz¹ ci twoj¹ g³upotê, bo Breagar z klanu Bardormar tego nie zrobi. Módl siê, by nasze œcie¿ki nigdy wiêcej siê nie przeciê³y.~
@75  = ~*wzdycha* To przez tê brodê, co? Od razu widaæ, ¿e ¿aden ze mnie drow.~
@76  = ~Twierdzisz, ¿e stoj¹ za tym ci mi³oœnicy drzew? <CHARNAME>, ci ludzie mo¿e i s¹ szaleni, ale nie s¹ groŸni.~
@77  = ~Za to ja przedstawiam ci teraz ostatni¹ rzecz, jaka kiedykolwiek ciê zainteresuje. Oto mój topór!~
@78  = ~Phi! Co niby stal mo¿e zdzia³aæ przeciwko mojej magii?~
@79  = ~Demoniczny pomiot w krasnoludzkiej twierdzy! Na topór Clangeddina, wracaj w piekielne otch³anie, zanim osobiœcie ciê tam wykopiê!~
@80  = ~Bawisz mnie, œmiertelniku. Opuœæ to miejsce, póki jeszcze mo¿esz!~
@81  = ~Có¿ to za plugawy podstêp! Wracaj do otch³ani, potworze! Tam twoje miejsce!~
@82  = ~Mocny w gêbie jesteœ, ch³opcze! Zobaczmy, czy potrafisz to poprzeæ czynem!~
@83  = ~Wiêc siê przekonajmy!~
@84  = ~Wiedzia³em, ¿e sk¹dœ znam to imiê... Buzzurk! Czyli na Wybrze¿u Mieczy w koñcu siê na tobie poznali i pogonili ciê stamt¹d?~
@85  = ~(Och, Mae'Var musi byæ pewny moich potê¿nych zdolnoœci, skoro chce, bym pracowa³ z czymœ takim...)~
@86  = ~Hrmf. Choæ nie cierpiê tego czerwonego drania... ale przynajmniej pozbêdziemy siê jakiegoœ maga. Bywa³y gorsze zadania.~
@87  = ~Proponujê za³atwiæ to szybko. Nie mogê ju¿ znieœæ przebywania z nim w jednej dru¿ynie.~
@88  = ~<CHARNAME>! Cuchnie od niego zwietrza³ym piwem. Jeœli o mnie chodzi, powinniœmy ruszaæ dalej.~
@89  = ~Nikt ciê jednak o zdanie nie pyta³. (Ty nieokrzesany pawianie).~
@90  = ~Coœ ty powiedzia³?!~
@91  = ~Jeœli chcesz, z radoœci¹ powtórzê to jeszcze raz, g³oœno i wyraŸnie!~
@92  = ~Na topór Clangeddina! Chyba bêdê musia³ nauczyæ ciê dobrych manier!~
@93  = ~Och, zachowuj siê i pozwól nam skoñczyæ interesy. Wiêc, co wy na to?~
@94  = ~Dobrze powiedziane, cz³owieku. W¹tpiê jednak, by wasze kopalnie siêga³y doœæ g³êboko, by dokopaæ siê do prawdziwej grozy.~
@95  = ~Có¿, muszê jednak przyznaæ, ¿e nasze w³asne problemy s¹ dla mnie wystarczaj¹co straszne.~
@96  = ~Phi, brzmisz niemal tak, jakbyœmy to my byli tutaj problemem. Ch³opcze, nie przeganiaj ludzi, którzy próbuj¹ ci pomóc.~
@97  = ~Jeden dzieñ! Pamiêtajcie!~
@98  = ~Wiêc... to ty jesteœ tym smokiem, którego kilka lat temu Harfiarze przepêdzili z Burzowych Rogów... Buzzurk.~
@99  = ~Czy¿by moja reputacja wyprzedzi³a mnie nawet tutaj? Och nie... niech zgadnê. Pochodzisz stamt¹d, prawda?~
@100 = ~Niechêtnie zostawiam tê bestiê przy ¿yciu... ale pewnego dnia spotka go zas³u¿ona kara.~
@101 = ~Oczywiœcie, ¿e pozwolimy ci odejœæ. Na kikutach twoich odr¹banych nóg, ty œmierdz¹ca bestio!~
@102 = ~Uwa¿aj, m³okosie! Lepiej zmieñ ton, bo wepchnê ci te s³owa z powrotem do gard³a!~
@103 = ~Ju¿ za sam¹ tê groŸbê powinienem ciê zamkn¹æ! S³u¿ê w P³omiennej Piêœci!~
@104 = ~A ja jestem Breagar z klanu Bardormar, ch³opcze. Na m³ot Moradina! Jestem prawym krasnoludem!~
@105 = ~K³amstwa, same k³amstwa! Poddajcie siê prawu!~
@106 = ~<CHARNAME>! Niech bogowie sprawi¹, by twoje piwo skwaœnia³o! W co ty mnie wci¹gasz?~
@107 = ~Jesteœ z t¹ osob¹? To oznacza œmieræ równie¿ dla ciebie!~
@108 = ~O rany... Pope³niasz wielki b³¹d.~
@109 = ~Giñ w imieniu P³omiennej Piêœci!~
@110 = ~Buzzurk! <CHARNAME>! Ktoœ zrobi³ z nas g³upców... i za³o¿ê siê o bary³kê najlepszego piwa, ¿e stoi za tym jakiœ mag.~
@111 = ~Durny z ciebie ch³ystek, <CHARNAME>. ¯aden rozs¹dny krasnolud nie odrzuci³by pomocnej d³oni w potrzebie.~ ~Durn¹ z ciebie dziewucha, <CHARNAME>. ¯aden rozs¹dny krasnolud nie odrzuci³by pomocnej d³oni w potrzebie.~
@112 = ~<CHARNAME>! Wiem, ¿e musimy zadoœæuczyniæ za to, co zrobiliœmy, ale mam ju¿ po dziurki w nosie tych ci¹g³ych d³ugów u innych. ZnajdŸmy dziecko tego cz³owieka! Buzzurk!~
@113 = ~Chyba raczej niewyobra¿alnie durny... Co? Nie patrz tak na mnie!~
@114 = ~Na mi³oœæ Berronar! Czy ja naprawdê codziennie mam znosiæ takie marudzenie?~
@115 = ~Nie mów mi, ¿e nie cieszy ciê ten widok! Jesteœ taki sam, jak inni!~
@116 = ~Brzmi jak coœ wiêcej ni¿ tylko ziarno prawdy.~
@117 = ~Có¿, doszed³em do tego samego wniosku.~
@118 = ~Zgrzeszy³eœ przeciwko wszystkiemu, co dobre i œwiête, magu. Pozwoli³eœ, by Topór Berronar zosta³ sprzedany i ukrad³eœ duszê mojej przyjació³ki. Teraz spotka ciê zas³u¿ona kara! Na topór Clangeddina!~
@119 = ~Znam historiê wie¿y Durlaga nad wyraz dobrze, mistrzu Hurganie, ale o losie tego sztyletu nigdy nie s³ysza³em. Œwiadomoœæ, ¿e brakuje ci tak wa¿nego elementu rodowego skarbu, musi byæ dla ciebie wielce bolesna.~
@120 = ~Dobrze powiedziane, m³ody krasnoludzie.~
@121 = ~Hrmf. Wiêc wróg mojego wroga staje siê moim przyjacielem, co? Zwykle niewiele by mnie obchodzi³o parê ¿o³êdzi, ale nikt nie powinien cierpieæ w niewoli u tego... potwora.~
@122 = ~Wie¿a Durlaga! <CHARNAME>! Ju¿ sama ta nazwa sprawia, ¿e dreszcz przebiega mi po plecach. I nie s¹ to dreszcze radoœci, tyle ci powiem.~
@123 = ~O, czy¿byœmy mieli tu eksperta? Z tego co pamiêtam, to JA tu jestem przewodnikiem.~
@124 = ~Oczywiœcie. A potem Durlag wyz³oci³ sobie brodê i walczy³ toporem wykutym z meteorytu.~
@125 = ~Nie wierz we wszystko, co us³yszysz, <CHARNAME>. Durlag rzeczywiœcie by³ bogaty, ale nie a¿ tak.~
@126 = ~Wypraszam sobie. Z tego co pamiêtam, to JA tu jestem przewodnikiem.~
@127 = ~Przeklêta duergarska zaraza! Wracajcie do Podmroku, gdzie wasze miejsce!~
@128 = ~Przeklête nasienie! Ka¿dy z nich to skaza na tym œwiecie, któr¹ powinno siê jak najszybciej zetrzeæ, Buzzurk! Chêtnie wskoczy³bym smokowi do gard³a, gdyby to oznacza³o, ¿e poci¹gnê ze sob¹ kilku tych szubrawców!~
@129 = ~Breagarze! Co siê z tob¹ dzieje?~
@130 = ~Tak zareagowa³by ka¿dy przyzwoity krasnolud w obliczu tych... tych... groscharbulnazdwarmos!~
@131 = ~Przera¿asz mnie...~
@132 = ~Szukamy odpowiedzi! Gdzie s¹ ci, co plugawi¹ ¿elazo? Mamy do nich kilka pytañ!~
@133 = ~Chcesz mojej rady? Uciekaj i nigdy nie wracaj, jeœli ci ¿ycie mi³e!~
@134 = ~Ju¿ nigdy nikogo nie uderzysz, handlarzu niewolników!~
@135 = ~Niech Dumathoin wyprowadzi jego duszê z jaskiñ ku œwiat³oœci.~
@136 = ~Milcz, nêdzniku! Nigdy nie obchodzi³o ciê nic poza w³asnym ty³kiem, a teraz nagle martwisz siê o duszê Khalida? Hipokryta!~
@137 = ~Ekhm, a co z t¹ nagrod¹?~
@138 = ~No, ja...~
@139 = ~Uratowaliœmy ciê przed niedŸwiedziem, a ty chcesz tak po prostu znikn¹æ? Buzzurk! Jeœli w ci¹gu trzech sekund nie oka¿esz nam wdziêcznoœci, znajdê kap³ana, który wskrzesi tego niedŸwiedzia!~
@140 = ~Uratowaliœmy ciê przed niedŸwiedziem i tak nam dziêkujesz? Buzzurk! Jeœli nie oka¿esz nam wdziêcznoœci w ci¹gu trzech sekund, znajdê kap³ana, który wskrzesi tego niedŸwiedzia!~
@141 = ~Hobgobliny? To bêdzie dziecinnie proste!~
@142 = ~Skoro tak, to nie stójcie tak bezczynnie! Zróbcie coœ!~
@143 = ~Och, tak s¹dzisz? PodejdŸ bli¿ej i przekonaj siê, jak krwio¿ercza potrafi byæ ta bestia!~
@144 = ~Uspokój siê, przyjdzie i twoja kolej!~
@145 = ~Ja ciê zaraz nauczê szacunku, gnomie. Szykuj siê na spotkanie ze stwórc¹. Dzisiaj zginiesz.~
@146 = ~Nie! *kaszle*~
@147 = ~Miejmy nadziejê, ¿e ten g³upiec wykorzysta swoj¹ szansê – œwiat nie potrzebuje kolejnego religijnego oszo³oma.~
@148 = ~Ostro¿nie! Jest z nimi Breagar z klanu Bardormar!~
@149 = ~Bardormar? Phi! Banda taplaj¹cych siê w b³ocie, spó³kuj¹cych z koboldami wieœniaków z jakiejœ dziury!~
@150 = ~Buzzurk! O, po¿a³ujesz tych s³ów! Broñ siê!~
@151 = ~Z wielk¹ chêci¹!~
@152 = ~Surowy wyrok, ale jaki wybór ma zakon? Buzzurk, wróg wewnêtrzny jest znacznie groŸniejszy ni¿ szubrawcy z zewn¹trz.~
@153 = ~<CHARNAME>! Znowu wpakowa³eœ nas w k³opoty? B¹dŸ ostro¿ny, nie powinniœmy zadzieraæ z tym krasnoludem.~ ~<CHARNAME>! Znowu wpakowa³aœ nas w k³opoty? B¹dŸ ostro¿na, nie powinniœmy zadzieraæ z tym krasnoludem.~
@154 = ~A co to za stary pryk? Macie ze sob¹ jakiegoœ przeklêtego podziemca? Ha! Na flaki mojego zmar³ego dziadka, bêdziemy mieli niez³y ubaw!~
@155 = ~Naprawdê durny z ciebie m³okos, <CHARNAME>. Jak g³êboko chcesz siê daæ wci¹gn¹æ w to bagno?~ ~Naprawdê durna z ciebie, dziewucha, <CHARNAME>. Jak g³êboko chcesz siê daæ wci¹gn¹æ w to bagno?~
@156 = ~Jak ci siê nie podoba, to mo¿esz sp³ywaæ, podziemcze! Nikt ciê tu si³¹ nie trzyma.~
@157 = ~Mam niby pozwoliæ, ¿eby <CHARNAME> musia³ wys³uchiwaæ twoich bzdur? Niedoczekanie, dwarkarmos!~ ~Mam niby pozwoliæ, ¿eby <CHARNAME> musia³a wys³uchiwaæ twoich bzdur? Niedoczekanie, dwarkarmos!~
@158 = ~Módl siê, byœmy siê ponownie nie spotkali! O ile jakikolwiek bóg zechce ciê wys³uchaæ! Nastêpnym razem nie bêdzie litoœci!~
@159 = ~Po¿a³ujesz dnia, w którym mnie pozna³eœ!~
@160 = ~Ma³emu... przeklêtemu... bêkartowi? Buzzurk! Okaza³bym ³askê, gdybyœ ty okaza³ skruchê! Teraz dosiêgnie ciê gniew Moradina!~
@161 = ~Buzzurk! Wygl¹da na to, ¿e nici z pieczonego kurczaka. Szlag by to!~
@162 = ~To – *gdak* – m¹drze prawisz!~
@163 = ~Czekaj... my? Co, na wszystkie diab³y w Otch³ani i poza ni¹, rozumiesz przez „my”?~
@164 = ~WY odbêdziecie tê podró¿. Czy¿ nie cieszy ciê ta przygoda?~
@165 = ~Ty... ty sobie stroisz ¿arty ze starego Breagara, co? Przecie¿ nie mo¿esz naprawdê...~
@166 = ~Nie! Nie mo¿esz mówiæ powa¿nie!~
@167 = ~Oczywiœcie, ¿e mówiê powa¿nie, Breagarze.~
@168 = ~O co znowu chodzi?~
@169 = ~Breagarze, weŸ siê w garœæ! Przynosisz mi wstyd.~
@170 = ~CZY SAMA UMBERLEE NAROBI£A CI DO £BA?!~
@171 = ~CHCESZ MNIE ZAWLEC NA STATEK? NA BRODY PRZODKÓW! PRÊDZEJ ZBUDUJÊ SOBIE CHATÊ W LESIE I BÊDÊ ¯AR£ LIŒCIE DO KOÑCA ¯YCIA, NI¯ POSTAWIÊ CHOÆBY KAWA£EK STOPY NA POK£ADZIE!~
@172 = ~Uspokój siê, Breagarze. Nikt ciê nie zmusza, byœ z nami p³yn¹³.~
@173 = ~No có¿, jeœli brak ci odwagi...~
@174 = ~Breagarze, proszê. Potrzebujemy ciê.~
@175 = ~Phi! <CHARNAME>! Nie traktuj mnie jak histerycznej baby!~
@176 = ~¯e niby mi brak odwagi? Powinienem ciê tu i teraz rozpo³owiæ! Jesteœ przeklêtym zdrajc¹!~ ~¯e niby mi brak odwagi? Powinienem ciê tu i teraz rozpo³owiæ! Jesteœ przeklêt¹ zdrajczyni¹!~
@177 = ~Mo¿esz siê przymilaæ i braæ mnie pod w³os, ile ci siê ¿ywnie podoba, <CHARNAME>. Ja zdania nie zmieniê!~
@178 = ~Ty durniu, wiesz doskonale, ¿e wi¹¿e mnie przysiêga, by za tob¹ pod¹¿aæ i teraz bezczelnie to wykorzystujesz! Ale tu siê przeliczy³eœ!~ ~Ty miernoto, wiesz doskonale, ¿e wi¹¿e mnie przysiêga, by za tob¹ pod¹¿aæ i teraz bezczelnie to wykorzystujesz! Ale tu siê przeliczy³aœ!~
@179 = ~Obiecujê ci jedno – jeœli wejdziemy na tê krypê i jakimœ cudem ona zatonie, to osobiœcie ciê utopiê, o ile prze¿yjesz! Nêdzny ch³ystek! Dobra, miejmy to ju¿ z g³owy!~ ~Obiecujê ci jedno – jeœli wejdziemy na tê krypê i jakimœ cudem ona zatonie, to osobiœcie ciê utopiê, o ile prze¿yjesz! Nêdzna dziewucha! Dobra, miejmy to ju¿ z g³owy!~
@180 = ~Jeœli skoñczy³eœ ju¿ siê wydzieraæ, mo¿emy ruszaæ.~
@181 = ~Nigdy, tu ohydny plugawicielu ¿elaza! Zginiesz tu i teraz!~
@182 = ~Och, trochê za bardzo w siebie wierzymy, co? Gadaj, jak siê nazywasz, kobieto, ¿ebyœmy wiedzieli, co napisaæ na twoim grobie!~
@183 = ~Potwory? Ruszajmy, <CHARNAME>. Z chêci¹ wezmê udzia³ w jakiejœ bitce!~
@184 = ~Tak! Podoba mi siê takie podejœcie!~
