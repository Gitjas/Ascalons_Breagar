@263 = ~Prawo stawia tê sprawê jasno, a jednak... Buzzurk. Nie zazdroszczê ci po³o¿enia.~
@264 = ~Nic dziwnego, ¿e ten œwiêtoszkowaty oœlizg³y miêczak nie chce siê tam zapuszczaæ. Tak g³êboko pod ziemi¹ nie ma niczego, z czym zmierzy³bym siê w w³asnej woli.~
@265 = ~Czasem po prostu nie ma innego wyjœcia.~
@266 = ~A mo¿e byœ tak skoczy³ do najbli¿szej dziury?~
@267 = ~Ilekroæ z³o podnosi ³eb, musimy reagowaæ! Bez wzglêdu na to, kogo to dotyczy. Ty oczywiœcie tego nie pojmiesz, drowko.~
@268 = ~G³upi hargluk, musisz siê tak wydzieraæ? Czy ja wygl¹dam na tak zmarzniêt¹, ¿e chcesz mnie od razu paliæ na stosie?~
@269 = ~Czysty... Buzzurk! Czy ty w ogóle wiesz, o co prosisz, cz³owieku? Ilit to... to przecie¿...~
@270 = ~Oczywiœcie, ¿e wiem... cz³owieku.~
@271 = ~Duergar? Buzzurk! Chcesz robiæ z nim interesy? To... to jest nie do pomyœlenia!~
@272 = ~Na bogów, nie wrzeszcz tak! Owszem, robiê, i co z tego?~
@273 = ~Ha! Œwiête s³owa, paladynie! Nareszcie ktoœ w tej dru¿ynie, kto nie postrada³ wszystkich zmys³ów.~
@274 = ~Miejmy nadziejê, ¿e tak zostanie, mój przyjacielu.~
@275 = ~Czemu mnie to nie dziwi? Zostawiamy za sob¹ tylko œmieræ i zniszczenie, a wci¹¿ trafiaj¹ siê g³upcy, którzy chc¹ na nas próbowaæ swojego szczêœcia.~
@276 = ~To nie tak! Nie mam innego wyjœcia!~
@277 = ~*parska* Co z ciebie za krasnolud, skoro dajesz sobie tak bezczelnie podprowadziæ broñ?~
@278 = ~Taa, jasne. Honor, si³a i te bzdury. Gadaæ sobie mo¿esz, ale taki gnoll przy upadku potrafi naprawdê solidnie r¹bn¹æ.~
@279 = ~Feldepost oszustem? Phi, przesadzasz, bardzie, ale rzeczywiœcie 300 sztuk z³ota to kupa grosza, <CHARNAME>.~
@280 = ~P³atnoœæ do rêki. Wchodzisz w to?~
@281 = ~Hej, przyjacielu. Jeœli nie przestaniesz tak k³apaæ jadaczk¹, to bêdê musia³ ci j¹ przymkn¹æ na sta³e!~
@282 = ~Uspokój siê, przy-przyjacielu. Nie w-widzisz, j-j-jak on jest n-napruty?~
@283 = ~Phi, jeœli nie potrafi piæ, to nie powinien tykaæ gorza³ki!~
@284 = ~Wynocha, powiedzia³em!~
@285 = ~Heh, musisz mieæ pêkat¹ sakiewkê.~
