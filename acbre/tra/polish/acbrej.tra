@95  = ~Hrmf.~
@96  = ~<CHARNAME>... To proroctwo wcale mi siê nie podoba. Popio³y bogów? Przetasowanie kart? Nie, to Ÿle wró¿y. Myœlê, ¿e powinniœmy siê st¹d wynosiæ, i to szybko.~
@97  = ~<CHARNAME>, czekaj chwilê! To Ralf, jeden z czeladników Taeroma. Wygl¹da na to, ¿e idzie prosto do nas!~
@98  = ~Przemyœla³em to wszystko i podj¹³em ju¿ decyzjê.~ [acbre_72]
@99  = ~S³uchaj.~
@100 = ~Jesteœ pomiotem Bhaala. Nie pozwolê ci sprowadziæ zagro¿enia na Faerun. Giñ w imiê Morndinsamman!~
@101 = ~Jesteœ dzieciêciem Bhaala i jeszcze nie wiem, co to rzeczywiœcie oznacza. Bêdê ci patrzy³ na rêce i modli³ siê do bogów, ¿ebyœ nie zboczy³ ze œcie¿ki prawoœci.~ ~Jesteœ dzieciêciem Bhaala i jeszcze nie wiem, co to rzeczywiœcie oznacza. Bêdê ci patrzy³ na rêce i modli³ siê do bogów, ¿ebyœ nie zboczy³a ze œcie¿ki prawoœci.~
@102 = ~Mo¿e i p³ynie w tobie krew Bhaala, ale nie widzê w tobie z³a. Bêdê dalej za tob¹ pod¹¿aæ i modliæ siê, ¿ebyœ nie zboczy³ z w³aœciwej drogi.~ ~Mo¿e i p³ynie w tobie krew Bhaala, ale nie widzê w tobie z³a. Bêdê dalej za tob¹ pod¹¿aæ i modliæ siê, ¿ebyœ nie zboczy³a z w³aœciwej drogi.~
@103 = ~Pomiot Bhaala czy nie – nie ma w tobie skazy. Jesteœ ¿ywym przyk³adem dobra i przysiêgam na wszystkich bogów, ¿e bêdê ci dalej towarzyszyæ. Buzzurk! Mamy mnóstwo ³bów do roztrzaskania! Na co jeszcze czekamy?~
@104 = ~Na ca³y Morndinsamman, co siê... co siê sta³o?~ [acbre_58]
@105 = ~Spokojnie, mój przyjacielu. Mia³eœ wypadek.~ [ACREVI05]
@106 = ~Wypadek? Phi, to niemo¿liwe, Breagar nie miewa... Buzzurk!~ [acbre_59]
@107 = ~Ty! Kap³anko! Co, na wszystkie demony Otch³ani, zrobi³aœ z moj¹ rêk¹?~ [acbre_60]
@108 = ~Ja...~ [ACREVI06]
@109 = ~Odjê³aœ mi rêkê! Nie! Nie wolno ci by³o! Na topór Clangeddina, rozp³atam ciê za to!~ [acbre_61]
@110 = ~Nie! Ja... Pomocy! Uspokój siê!~ [ACREVI07]
@111 = ~Nie mam zamiaru siê uspokajaæ! Mój topór wymierzy ci nauczkê!~ [acbre_62]
@112 = ~Breagarze, oszala³eœ!~
@113 = ~Zamknij siê, ty gobliñski pomiocie!~
@114 = ~Breagarze! Opamiêtaj siê!~
@115 = ~O mnie ju¿ zapomnia³eœ, Breagarze? Mnie te¿ masz zamiar zaatakowaæ?~
@116 = ~Ca³y Breagar – jakiego znamy i kochamy.~
@117 = ~Kap³anko, jeœli to wszystko prawda, to pokornie proszê o wybaczenie. Da³em siê ponieœæ furii i plot³em bzdury.~
@118 = ~Wybaczam ci. Prze¿y³eœ straszliwy wstrz¹s.~
@119 = ~Dziêkujê ci. Powiedz tylko, jeœli mogê siê jakkolwiek odwdziêczyæ.~
@120 = ~Taeromie, przynios³em wstyd twojej kuŸni. Ciebie te¿ proszê o wybaczenie.~
@121 = ~Nie masz za co przepraszaæ, Breagarze. To by³ wypadek.~
@122 = ~Mimo wszystko, twoje kowad³o ju¿ na zawsze pozostanie splamione moj¹ hañb¹.~
@123 = ~No i ty, <CHARNAME>. Tobie d³u¿ny jestem ¿ycie tak samo, jak Revianel. Wybacz mi to, jak siê zachowa³em.~
@124 = ~Wybaczam ci, Breagarze.~
@125 = ~Wybaczam i puszczam wszystko w niepamiêæ. Tylko nie rób ju¿ nigdy niczego podobnego.~
@126 = ~Daruj sobie, krasnoludzie. Na to jest ju¿ trochê za póŸno.~
@127 = ~Myravar Mergulmtor, <CHARNAME>. Mój topór nale¿y do ciebie, wybawco mojej duszy. Bêdê sta³ u twego boku tak d³ugo, jak bêdziesz kroczyæ œcie¿k¹ prawoœci, jak d³ugo bêdziesz potrzebowa³ mojej pomocy lub dopóki nie odnajdziemy mordercy twojego ojca. Tak przysiêga Breagar, syn Baragara z klanu Bardormar. Niech Morndinsamman bêdzie moim œwiadkiem.~ ~Myravar Mergulmtor, <CHARNAME>. Mój topór nale¿y do ciebie, wybawczyni mojej duszy. Bêdê sta³ u twego boku tak d³ugo, jak bêdziesz kroczyæ œcie¿k¹ prawoœci, jak d³ugo bêdziesz potrzebowa³a mojej pomocy lub dopóki nie odnajdziemy mordercy twojego ojca. Tak przysiêga Breagar, syn Baragara z klanu Bardormar. Niech Morndinsamman bêdzie moim œwiadkiem.~
@128 = ~¯egnaj, Taeromie. I ty, kap³anko.~
@129 = ~Ja równie¿ siê oddalê. Niech bogowie czuwaj¹ nad waszymi œcie¿kami.~
@130 = ~Jeœli nie masz nic przeciwko, Revianel, to chêtnie ciê odprowadzê.~
@131 = ~Z chêci¹ skorzystam, szlachetny kowalu. Dziêkujê.~
@132 = ~<CHARNAME>... Ty te¿ powinieneœ ju¿ ruszaæ. Miejmy nadziejê, ¿e zanim wrócisz, wszystko wróci do normy.~ ~<CHARNAME>... Ty te¿ powinnaœ ju¿ ruszaæ. Miejmy nadziejê, ¿e zanim wrócisz, wszystko wróci do normy.~
@133 = ~ProwadŸ, <CHARNAME>.~
@134 = ~Nie przydam siê ju¿ w kuŸni. Mo¿e ktoœ tam w œwiecie znajdzie u¿ytek dla jednorêkiego krasnoluda. A jeœli nie m³ot, to od teraz topór bêdzie moim fachem.~
@135 = ~¯egnaj, <CHARNAME>.~
@136 = ~<CHARNAME>... czekaj.~
@137 = ~Czujesz to?~
@138 = ~Na topór Clangeddina! To uczucie... Nie czu³em czegoœ podobnego od stulecia!~
@139 = ~Mistyczne bzdury!~
@140 = ~Ty! Milcz,albo zaraz powalê jednym ciosem!~
@141 = ~Tak, tak.~
@142 = ~Wiesz, co to jest?~
@143 = ~Mam pewne przypuszczenia. I jeœli siê nie mylê, zaraz wydarzy siê coœ wielkiego.~
@144 = ~Co siê dzieje? Grozi nam niebezpieczeñstwo?~
@145 = ~Niczego nie wyczuwam.~
@146 = ~Masz halucynacje?~
@147 = ~Dziêkujê ci, <CHARNAME>. ¯ycz mi szczêœcia w podró¿y.~
@148 = ~Nie bêdziesz musia³ iœæ sam, Breagarze. Do³¹czê do ciebie i pomogê ci w tej szlachetnej misji.~
@149 = ~No to ruszajmy. Ku przygodzie!~