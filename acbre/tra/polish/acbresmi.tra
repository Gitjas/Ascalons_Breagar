@158 = ~Nie s¹dzê, bym potrzebowa³ twojej pomocy w tej podró¿y.~ ~Nie s¹dzê, bym potrzebowa³a twojej pomocy w tej podró¿y.~
@159 = ~Ha! Na topór Clangeddina! Wybijmy zêby ka¿demu, kto œmie kalaæ ¿elazo!~
