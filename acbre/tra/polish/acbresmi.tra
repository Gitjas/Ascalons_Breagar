@177 = ~Witaj, <CHARNAME>.~
@178 = ~Jest prawie gotowy, jeszcze tylko szlif i runy. Wróæ za kilka dni w nocy, gdy kuŸnia bêdzie zamkniêta dla ogó³u, a bêdziesz móg³ popatrzeæ.~ ~Jest prawie gotowy, jeszcze tylko szlif i runy. Wróæ za kilka dni w nocy, gdy kuŸnia bêdzie zamkniêta dla ogó³u, a bêdziesz mog³a popatrzeæ.~
@179 = ~Robota skoñczona, a ksiê¿yc wysoko. To idealny czas na wybicie run. Przyjrzyj siê dobrze, <CHARNAME>. Patrz, jak pracuje mistrz!~
@180 = ~Gdy ja podró¿owa³em z tob¹ wzd³u¿ Wybrze¿a Mieczy, ten amator zdo³a³ zawaliæ kilka kontraktów! Jest mnóstwo roboty!~
@181 = ~Zrobiê wiêcej w godzinê, ni¿ ty zdo³asz przez dzieñ z tym twoim wiecznym narzekaniem!~