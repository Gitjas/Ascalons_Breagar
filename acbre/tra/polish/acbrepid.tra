@101 = ~Moradin to Kowal Dusz, Wszechojciec krasnoludów. To do niego nale¿y tchniêcie duszy w krasnoluda i to on s¹dzi nas po œmierci. To m¹dry i sprawiedliwy, lecz nieub³agany sêdzia. Moradin nakazuje nam czyniæ dobro i bez litoœci wypleniaæ z³o.~
@102 = ~Berronar to ma³¿onka Moradina. Wielebna Matka roztacza opiekê nad klanem, b³ogos³awi rodzinom i zakochanym. Jest srog¹, lecz kochaj¹c¹ opiekunk¹ dla wszystkich krasnoludów.~
@103 = ~Clangeddin to Ojciec Bitew, postrach goblinów i pogromca olbrzymów. Wspiera prawych wojowników w boju i ceni honorow¹ walkê, bez podstêpów czy zdrady. To on nauczy³ nas, jak wywijaæ ¿elastwem przeciw olbrzymom i gdzie ich r¹baæ, ¿eby zabola³o... jeœli wiesz, co mam na myœli.~
@104 = ~Dugmaren to Wêdrowny Odkrywca, bóg poszukiwañ, wiedzy i wynalazków.~
@105 = ~Dumathoin czuwa nad górnikami w g³êbinach i prowadzi zmar³ych do biesiadnych pa³aców po drugiej stronie.~
@106 = ~Haela jest bogini¹ szczêœcia i mêstwa. Patronuje ka¿demu œmia³kowi, który chce oczyœciæ Toril z plugawych potworów.~
@107 = ~Gorm to stra¿nik krasnoludzkich twierdz, bóg Wiecznie Czujny. Pan Br¹zowej Maski przyzywa swe awatary zawsze wtedy, gdy siedziba krasnoludów wymaga obrony, a bitwa wydaje siê ju¿ przegrana.~
@108 = ~Marthammor Duin opiekuje siê wêdrowcami. Gdy krasnolud rusza w drogê, wzywa na pomoc Znajduj¹cego Szlaki.~
@109 = ~*Breagar spluwa siarczyœcie* Nic nie wiem o tym poganiaczu duergarów i wiedzieæ nic nie chcê.~
@110 = ~Abbathor to jedyny z³y bóg, którego Moradin toleruje. To pan chciwoœci i zawiœci. Naucza, ¿e ka¿da droga do pomno¿enia bogactwa jest dobra, o ile tylko nie cierpi na tym ¿aden krasnolud.~
@111 = ~Sharindlar? Zaskakujesz mnie, <CHARNAME>. Nie spodziewa³em siê, ¿e znasz jej imiê. Pani ¯ycia i Litoœci nie cieszy siê wielk¹ powag¹ poœród dwarmos. Pewnie dlatego, ¿e nikomu spoza naszej rasy nie mieœci siê w g³owie, by krasnoludy mog³y znajdowaæ upodobanie w wdziêku, wspó³czuciu i romansach.~
@112 = ~O Thardzie Harrze niewiele potrafiê powiedzieæ. Wiem tylko, ¿e czcz¹ go dzikie krasnoludy ¿yj¹ce gdzieœ w dalekich puszczach. Ale kogo oni obchodz¹?~
@113 = ~Vergadain, rozeœmiany krasnolud? To bóg handlu, uk³adów i twardych negocjacji.~
@114 = ~Smok kradnie z³oto, ¿eby spaæ na nim, a krasnolud kradnie z³oto, ¿eby spaæ z nim.~
@115 = ~Ten ¿art jest stary jak œwiat, <CHARNAME>.~
@116 = ~Có¿, mnie wyda³ siê zabawny.~
@117 = ~Myœlê, ¿e mamy teraz chwilê, byœ móg³ popracowaæ przy kuŸni, Breagarze.~
@118 = ~Wspomina³eœ, ¿e chcia³byœ pokombinowaæ z ogniwami energetycznymi z wiêzienia Irenicusa. Tam nie by³o na to czasu. Chcesz spróbowaæ tutaj?~
@119 = ~Zajmij siê tymi ogniwami. Mamy teraz na to czas.~
@120 = ~Czy chcê? Mo¿esz byæ tego pewny, <CHARNAME>! Rêce mnie œwierzbi¹, odk¹d tu weszliœmy! I tak ju¿ stanowczo za d³ugo taszczymy te graty ze sob¹.~ ~Czy chcê? Mo¿esz byæ tego pewna, <CHARNAME>! Rêce mnie œwierzbi¹, odk¹d tu weszliœmy! I tak ju¿ stanowczo za d³ugo taszczymy te graty ze sob¹.~
@121 = ~Dobrze, bêdê o tym pamiêtaæ. Teraz niestety nie mamy na to czasu.~
@122 = ~No, to zobaczmy, czy wyjdzie z tego to, co sobie wymyœli³em. Na Moradina!~