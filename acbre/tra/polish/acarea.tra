@175 = ~Co jest, Breagarze? Strach przed œmierci¹ odebra³ ci mowê? Gdzie siê podzia³ twój niewyparzony jêzyk i te krasnoludzkie brednie o szacunku dla zmar³ych?~
@176 = ~Mój szacunek dla zmar³ych ma siê bardzo dobrze, drowko, ale ty i tobie podobni nigdy tego nie pojmiecie.~
@177 = ~Mo¿e i krasnoludy inaczej patrz¹ na œmieræ, ale przynajmniej nie czcimy bliskich, upychaj¹c ich w kamiennych pud³ach.~
@178 = ~Phi! Szkoda czasu na u¿alanie siê nad zgni³ym œcierwem. W tych kultach œmierci najlepsze s¹ b³yskotki, które pakuj¹ trupom do kieszeni!~
@179 = ~Zaczynam rozumieæ, czemu w³asny klan wykopa³ ciê na zbity pysk...~
@180 = ~Dobrze widzieæ, ¿e czujni bogowie wci¹¿ maj¹ tu swoich wiernych.~
@181 = ~Prychaj sobie, ile chcesz, drowko. Mnie to nie rusza.~
@182 = ~Idioto! Mo¿e drzyj siê jeszcze g³oœniej? Czy wygl¹dam na kogoœ, kto potrzebuje stosu, ¿eby siê ogrzaæ?~
@183 = ~B¹dŸ pewna, ty mroczna wyw³oko, ¿e nie przystawi³em ci pochodni do twarzy tylko dlatego, ¿e jest tu z nami <CHARNAME>.~
@184 = ~Wygl¹da na to, ¿e rozegra³a siê tu jakaœ bitwa. Na topór Clangeddina, wcale mi siê to nie podoba!~
@185 = ~Niezale¿nie od zagro¿enia, musimy przeæ naprzód!~
@186 = ~Wcale nie zamierza³em uciekaæ, Keldornie. Po prostu czujê w powietrzu odór z³a.~
@187 = ~Staniemy zatem ramiê w ramiê przeciwko tej nieczystoœci, czymkolwiek by nie by³a.~
@188 = ~Dobrze powiedziane, przyjacielu.~
@189 = ~Buzzurk. Nie podoba mi siê to miejsce, <CHARNAME>. Cokolwiek siedzi tam na dole, Ÿle siê zapowiada.~
@190 = ~W³aœnie dlatego tu jesteœmy, Breagarze! Boo mówi, ¿e cel jest ju¿ blisko!~
@191 = ~Boo to jednak sprytny chomik... *wzdycha*~
@192 = ~Co za widok.~
@193 = ~Szkoda, ¿e pewnie nie dostaniemy siê do œrodka bez walki. Nie rób niczego g³upiego, <CHARNAME>.~
@194 = ~Znalaz³bym tuzin miejsc, w których wola³bym teraz byæ, niemniej... wchodŸmy do œrodka, <CHARNAME>. Niech nasz trud siê w koñcu op³aci.~
@195 = ~Hrmf.~
@196 = ~Miejmy nadziejê, ¿e ta wycieczka do mi³oœników drzew oka¿e siê owocna.~
@197 = ~Breagarze, jesteœmy tu, by zbadaæ zachwianie równowagi. Oczywiœcie, ¿e oka¿e siê owocna.~
@198 = ~Phi. Równowaga.~
@199 = ~S³uchaj mnie uwa¿nie! Nic mnie obchodzi to twoje bredzenie o równowadze! Buzzurk, chêtnie spali³bym ka¿de drzewo w tym lesie, byle tylko rozpaliæ porz¹dn¹ kuŸniê i wykuæ porz¹dny kawa³ bi¿uterii!~
@200 = ~Daj mi spokój z t¹ gadanin¹ o naturze! Jestem tu tylko po to, ¿eby wpakowaæ komuœ topór miêdzy oczy!~
@201 = ~Uwierz mi, im szybciej odpuœcisz, tym lepiej dla wszystkich. Prêdzej na dêbie urosn¹ agresty, ni¿ krasnolud zacznie doceniaæ uroki przyrody.~
@202 = ~Naprawdê powinienem ciê zat³uc na miejscu, <CHARNAME>.~
@203 = ~Tak, powinienem ciê ut³uc za to, jak niewyobra¿alnie jesteœ durny. Powinieneœ by³ wiedzieæ, jakie mam zdanie na temat statków i ³odzi...~ ~Tak, powinienem ciê ut³uc za to, jak niewyobra¿alnie jesteœ durna. Powinnaœ by³a wiedzieæ, jakie mam zdanie na temat statków i ³odzi...~
@204 = ~Ale to... to musi poczekaæ, bo a¿ mnie skrêca z oburzenia.~
@205 = ~Minsc i Boo czuj¹ twój gniew, Breagarze. B¹dŸ jednak pewien, ¿e jeœli chodzi o kopanie ty³ków, si³a Minsca ani trochê nie os³ab³a!~
@206 = ~Daj spokój, prze¿y³eœ ju¿ tyle, ¿e ten jeden incydent ciê nie z³amie.~
@207 = ~WeŸ siê w garœæ, Breagarze. To nie pora na poddawanie siê!~
@208 = ~Buzzurk. Skoñczy³em pod wod¹ wœród jakichœ ryboludzi, a dowodzi nami jakiœ szaleniec, który zmienia siê w demona, gdy tylko straci panowanie nad sob¹.~ ~Buzzurk. Skoñczy³em pod wod¹ wœród jakichœ ryboludzi, a dowodzi nami jakaœ wariatka, która zmienia siê w demona, gdy tylko straci panowanie nad sob¹.~
@209 = ~I na dodatek przysi¹g³em mu lojalnoœæ. O Marthammorze Duinie, opiekunie wêdrowców, miej mnie w opiece...~ ~I na dodatek przysi¹g³em jej lojalnoœæ. O Marthammorze Duinie, opiekunie wêdrowców, miej mnie w opiece...~
@210 = ~Na m³ot Moradina.~
@211 = ~Nigdy bym nie pomyœla³, ¿e te d³ugouchy zdo³aj¹ stworzyæ coœ tak piêknego.~
@212 = ~Teraz ju¿ rozumiesz, Breagarze? Da siê zbudowaæ coœ kunsztownego bez niszczenia przyrody.~
@213 = ~To miasto to prawdziwy cud, <CHARNAME>. Ten ³ajdak Irenicus nie mo¿e go zniszczyæ!~
@214 = ~Tu nie jest zbyt bezpiecznie, <CHARNAME>. Takie przewê¿enia to wymarzony teren dla zbójów.~
@215 = ~Ka¿dy z nas odby³ ju¿ tak wiele podró¿y, ¿e doskonale zdaje sobie z tego sprawê, Breagarze.~
@216 = ~Phi. Wolê raz za du¿o przypomnieæ o zagro¿eniu, ni¿ potem ¿a³owaæ, ¿e tego nie zrobi³em.~
@217 = ~A wiêc to jest Most Firewine.~
@218 = ~Zaraz pewnie us³yszymy, ¿e krasnoludzka robota opar³aby siê up³ywowi czasu i by³aby w lepszej kondycji, co?~
@219 = ~A nie mam racji?~
@220 = ~Tê twierdzê zrówna³y z ziemi¹ wojna i zdrada, Breagarze. Nie lenistwo czy kiepska architektura.~
@221 = ~Mimo wszystko igrali z mocami, których nigdy nie nale¿a³o ruszaæ. Ponoæ w starej twierdzy a¿ roi siê od plugastwa.~
@222 = ~No, chocia¿ w tej kwestii masz racjê.~
@223 = ~Musimy uwa¿aæ, <CHARNAME>. Elfy z Firewine igra³y tu z magi¹ i nie wiadomo, co po niej zosta³o.~
@224 = ~<CHARNAME>! Œmierdzi tu – i to gnollem.~
@225 = ~Breagar chyba nie zamierza stchórzyæ w takim momencie, co?~
@226 = ~Phi, sam nie wierzysz w to, co mówisz, Minscu!~
@227 = ~Dobra, nauczmy te kundle kilku sztuczek. Siad. Le¿eæ. Zdychaæ.~
@228 = ~No i jesteœmy, <CHARNAME>. S³ynne kopalnie Nashkel. Zwyk³a dziura w ziemi. Phi.~
@229 = ~Gorzej – to rana, po której natura nie pozbiera siê przez sto lat!~
@230 = ~Nie masz zielonego pojêcia, o czym mówisz, elfko.~
@231 = ~Powinnaœ kiedyœ odwiedziæ kopalnie górskich klanów. Ci¹gn¹ siê kilometrami w g³¹b ska³, siêgaj¹c g³êbin, o jakich ludziom siê nawet nie œni³o!~
@232 = ~Teraz zaczn¹ siê schody, <CHARNAME>. Skoro to robactwo opanowa³o te¿ ten poziom, na pewno zastawili pu³apki.~
@233 = ~Czy¿by krasnolud nagle zacz¹³ baæ siê mrocznych tuneli?~
@234 = ~Nie masz najmniejszego pojêcia, co mo¿e tu na nas czekaæ, Jaheiro.~
@235 = ~Musimy zachowaæ ostro¿noœæ, jeœli chcemy wyjœæ st¹d ¿ywi.~
@236 = ~Najlepiej by³oby pos³aæ drowkê przodem.~
@237 = ~Postrada³eœ ten swój i tak mierny rozum? Wygl¹dam ci na szczura, który bêdzie wêszy³ w ka¿dym k¹cie za pu³apkami?~
@238 = ~Sk¹d¿e. Liczê po prostu, ¿e przy odrobinie szczêœcia wpadniesz w jakieœ wnyki. Dziêki temu dowiemy siê, gdzie s¹ pu³apki i przy okazji pozbêdziemy siê ciebie. Same korzyœci.~
@239 = ~Ty... nêdzny, kurduplowaty, nadêty, œmierdz¹cy... krasnoludzie! Powinni ciê powiesiæ do góry nogami nad jam¹ paj¹ków, ¿eby do tej pustej czachy nala³o siê choæ trochê oleju!~
@240 = ~B¹dŸ grzeczna i wracaj na miejsce, drowko. W przeciwnym wypadku sam poka¿ê ci gdzie twoje miejsce.~
@241 = ~*Viconia odwraca siê i mruczy kilka s³ów w swoim jêzyku – ³atwo domyœliæ siê ich znaczenia*.~
@242 = ~St¹paj ostro¿nie, <CHARNAME>. Jeœli masz kogoœ od pu³apek, niech teraz ruszy na zwiad.~
@243 = ~Ach, Pomocna D³oñ! Bentley mo¿e i jest stukniêtym gnomem, ale jego piwo jest jednak warte grzechu. Co ty na to, <CHARNAME>? Skoczymy na jednego?~
@244 = ~Breagarze, nie s¹dzisz, ¿e mamy wa¿niejsze sprawy na g³owie?~
@245 = ~Pusty brzuch to i nogi s³abe, paladynie! Nawet ty powinieneœ to wiedzieæ.~
@246 = ~Breagar ma absolutn¹ racjê! Minsc i Boo te¿ g³osuj¹ za kolejk¹!~
@247 = ~S³ucham?~
@248 = ~Tak, oczywiœcie, Boo. Minsc pomo¿e ci opró¿niæ kufel, jeœli oka¿e siê dla ciebie za du¿y.~
@249 = ~A potem siê dziwi¹, ¿e mówi siê, i¿ piwo tuczy i og³upia.~
@250 = ~*wzdycha*~
@251 = ~No to ruszajmy do Kniei Otulisko. Oby to przedzieranie siê przez ten chaos przynios³o pozytywne rezultaty.~
@252 = ~Nasza wyprawa odniesie sukces, jeœli powstrzymamy zniszczenie tego lasu.~
@253 = ~Patrzysz na kruch¹ leœn¹ równowagê! Tylko krasnolud móg³by widzieæ w tym zwyk³y chaos.~
@254 = ~Buzzurk! Tylko elf móg³by widzieæ w tym cokolwiek INNEGO!~
@255 = ~Ponoæ osiedli³ siê tu jakiœ arcymag. Phi.~
@256 = ~*Breagar spluwa na ziemiê*.~
@257 = ~Moim zdaniem powinniœmy omijaæ tê chatê szerokim ³ukiem.~
@258 = ~Krasnoludzie, lepiej milcz w sprawach, o których nie masz bladego pojêcia. (Czyli o wszystkim poza ¿arciem, chlañskiem i robot¹).~
@259 = ~Jesteœ zbyt uprzedzony, Breagarze. Magia to u¿yteczny i potê¿ny sojusznik.~
@260 = ~Mój topór te¿ jest potê¿ny, ale nie r¹bnie mnie w twarz, gdy tylko na chwilê spuszczê go z oka! Buzzurk!~
@261 = ~¯elazny Tron! W koñcu! Buzzurk, ile¿ mo¿na czekaæ! Mo¿e w koñcu poznamy jakieœ odpowiedzi!~
@262 = ~*chichocze* A im przywódcom zgotujemy... Garshabazvelkardun?~
@263 = ~Chcesz wygarbowaæ skórê przywódcom?! Buzzurk. Szybko siê uczysz, m³oda.~
@264 = ~Mam wrodzony talent!~
@265 = ~Orothiar by³ jednym z najbogatszych klanów w okolicy, dopóki wiek temu nie dosz³o tu do katastrofy.~
@266 = ~Natura odebra³a to, co jej! To by³ doprawdy wspania³y dzieñ!~
@267 = ~Zwa¿aj na s³owa, kobieto! Wielu dzielnych i utalentowanych krasnoludów zginê³o, gdy kopalnia zosta³a zalana.~
@268 = ~Wielu dzielnych i utalentowanych krasnoludów zginê³o, gdy kopalnia zosta³a zalana.~
@269 = ~W swej chciwoœci kopali zbyt blisko wody. Mog¹ winiæ za to tylko samych siebie.~
@270 = ~Mniejsza z tym. S¹ tam ogromne z³o¿a ¿elaza. Jeœli nasi wrogowie znaleŸli sposób na ich wydobycie, siedz¹ na niemal nieograniczonych zapasach rudy.~
@271 = ~Nigdy jednak nie zdo³aj¹ wydobyæ jej w uczciwy sposób.~
@272 = ~Czujesz to, <CHARNAME>? To fetor zarazy i œmierci.~
@273 = ~A czego innego spodziewa³eœ siê tak g³êboko pod ziemi¹? *wzdycha*~
@274 = ~Nie masz pojêcia, o czym gadasz, elfie!~
@275 = ~W krasnoludzkiej kopalni powinno œmierdzieæ robot¹ i potem, a tutaj... czuæ tylko niewolniczy kierat i truch³a.~
@276 = ~To tutaj, <CHARNAME>. Ktoœ w okolicy gromadzi z³oto. Dos³ownie wyczuwam je w koœciach.~
@277 = ~Stoisz w œrodku lasu i czujesz... z³oto?~
@278 = ~To pewnie wyjaœnia sporo kwestii dotycz¹cych krasnoludów.~
@279 = ~Drzewa zostawiam tobie. Wygl¹daj¹, jakby desperacko potrzebowa³y przytulasa.~
@280 = ~Hrmf... <CHARNAME>, naprawdê musimy iœæ têdy?~
@281 = ~Tak blisko Aunfar?~
@282 = ~Ha! Musia³eœ niedawno opuœciæ Pa³ace! Pos³uchajcie tylko tego ¿ó³todzioba!~
@283 = ~Kagainie! Trzymaj ten parszywy ozór za zêbami, jeœli ci ¿ycie mi³e!~
@284 = ~Aunfar? Co to takiego?~
@285 = ~Chyba nie boisz siê wody?~
@286 = ~WeŸ siê w garœæ, Breagarze!~
@287 = ~Postaramy siê iœæ tak szybko, jak to mo¿liwe.~
@288 = ~Wie¿a Durlaga. Buzzurk, nie wierzê, ¿e widzê j¹ na w³asne oczy.~
@289 = ~Brrr! A¿ mnie ciarki przesz³y!~
@290 = ~I s³usznie, m³oda.~
@291 = ~Wie¿a Durlaga to dla nas legenda. Mroczna legenda, dodam. Imiê Durlaga zawsze s³u¿y³o za przestrogê, która mia³a nam przypominaæ, ¿eby nigdy nie czuæ siê zbyt pewnie.~
@292 = ~Naprawdê chcia³bym przyjrzeæ siê jej z bliska.~
@293 = ~SprawdŸmy zatem, czy uda nam siê znaleŸæ Galthura i Reggika.~
@294 = ~To miasto nie jest a¿ tak du¿e. Powinniœmy bez trudu trafiæ na tych krasnoludów.~
@295 = ~Czujesz to, <CHARNAME>? To zapach historii.~
@296 = ~Historii, która emanuje œmierci¹. Nie podoba mi siê tutaj.~
@297 = ~Spokojnie, m-moja kochana. Jestem przy tobie.~
@298 = ~To nie schronienie. To grób.~
@299 = ~Tak, rozejrzyj siê, <CHARNAME>. Podziwiaj tê wspania³¹ architekturê!~
@300 = ~Czujê tu œmieræ. Jest tak... tak zimno. <CHARNAME>! Coœ tu jest i chce nas zabiæ!~
@301 = ~To grobowiec. Nasz grobowiec. Wszyscy tu zginiemy.~
@302 = ~Durlag nie bez powodu uchodzi³ za jednego z najlepszych budowniczych na œwiecie. Wstyd, ¿e jego domostwo popada w ruinê. To miejsce trzeba oczyœciæ z wszelkiego plugastwa.~
@303 = ~Hmmm. Czujesz to, <CHARNAME>? Za³o¿ê siê o klejnot wielkoœci piêœci, ¿e w okolicy mieszkaj¹ nizio³ki zajmuj¹ce siê tym, co potrafi¹ najlepiej. Gotowaniem i warzeniem piwa.~
@304 = ~Powinniœmy odwiedziæ tê wioskê. Z pewnoœci¹ nam siê to op³aci!~
@305 = ~Gullykin, to zapyzia³a dziura. Jego mieszkañcy wol¹ siedzieæ przy piecu i udawaæ, ¿e œwiat na zewn¹trz nie istnieje.~
@306 = ~Naprawdê niewiele ci trzeba do szczêœcia, Breagarze.~
@307 = ~Niech ¯elazny Tron bêdzie trzykroæ przeklêty za to, ¿e postawi³ tê przeklêt¹ wie¿ê tak blisko portu.~
@308 = ~Jesteœ strasznym cynikiem, Breagarze. Naprawdê nigdy nie myœlisz o tych wszystkich historiach? O tych ch³opakach, którzy zaczynali jako majtkowie, a po latach wracali ob³adowani z³otem i klejnotami z dalekich stron?~
@309 = ~Nie, nie myœlê o tym, g³upia smarkulo. A wiesz dlaczego? Bo to stek bzdur. Na morzu nie ma z³ota – s¹ tylko burze. A w obcych krajach mieszkaj¹ obcy obwiesie, którzy nawet porz¹dnego piwa uwarzyæ nie potrafi¹!~
@310 = ~Ruszajmy st¹d, zanim od tego smrodu ryb cofnie mi siê œniadanie!~
@311 = ~Skóra mi cierpnie, <CHARNAME>. Coœ z t¹ wie¿¹ jest bardzo nie tak, czujê to w koœciach.~
@312 = ~Jestem tu¿ obok, przyjacielu Breagarze.~
@313 = ~Zamieszka³o tu coœ... z³ego. Sama nie wiem, czy chcê tam wchodziæ, <CHARNAME>.~
@314 = ~... Naprawdê musimy tam iœæ? Na zewn¹trz jest znacznie milej.~
@315 = ~Po co tu sterczymy i gapimy siê po pró¿nicy? To tylko stara, opuszczona wie¿a, nic wiêcej!~
@316 = ~Ta wie¿a przypomina mi dom mojego stryjecznego kuzyna, który na weselu siostry Ludmi³y uderzy³ g³ow¹ o stó³ o jeden raz za du¿o i ubzdura³ sobie, ¿e jest s³awnym magiem. Postawi³ potem bardzo podobn¹ budowlê...~
@317 = ~Buzzurk! Rzadko kiedy czu³em siê tak podle we w³asnej skórze. PrzejdŸmy przez to ca³e drowie œcierwo jak najszybciej, bym móg³ wreszcie odzyskaæ swoje cia³o.~
@318 = ~Nie rób scen, Breagarze. Nigdy bym nie przypuszcza³a, ¿e to powiem, ale twoje drowie cia³o jest... poci¹gaj¹ce.~
@319 = ~Bije od ciebie pewna... surowa mêskoœæ, któr¹ rzadko spotyka siê u elfów czy ludzi. Mo¿liwe, ¿e pozwolê ci kiedyœ dzieliæ ze mn¹ ³o¿e.~
@320 = ~Wybij to sobie z g³owy, Viconio! W przeciwnym wypadku sam ci to z niej wybijê kilkoma uderzeniami m³ota!~
@321 = ~Z takim podejœciem nic dziwnego, ¿e nie wysz³o ci z t¹ twoj¹ ukochan¹.~
@322 = ~Przestañ utyskiwaæ, krasnoludzie! Naprawdê wierzysz, ¿e ta twoja pucu³owata narzeczona mog³aby ci zaoferowaæ te same rozkosze, co wprawna i doœwiadczona drowka?~
@323 = ~Œmiesz wymawiaæ imiê Audhild? Skoñcz z tymi bezeceñstwami, albo osobiœcie wyrwê ci ten twój parszywy ozór! Nie jesteœ godna nawet o niej wspominaæ!~