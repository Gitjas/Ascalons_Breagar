@149 = ~I tak zrobiê. Sporo ci zawdziêczam, ch³opcze, a Breagar zawsze dotrzymuje s³owa. Mo¿esz na to liczyæ!~ ~I tak zrobiê. Sporo ci zawdziêczam, dziewczê, a Breagar zawsze dotrzymuje s³owa. Mo¿esz na to liczyæ!~
@150 = ~Na pewno tak bêdzie, <CHARNAME>. Ale to nie znaczy, ¿e musi mi siê to podobaæ.~
@151 = ~O tak, jasne! Sami bogowie ingeruj¹ w moje ¿ycie, a ty mi mówisz, ¿e siê „za du¿o zamartwiam”. Dziwny z ciebie goœæ, <CHARNAME>.~ ~O tak, jasne! Sami bogowie ingeruj¹ w moje ¿ycie, a ty mi mówisz, ¿e siê „za du¿o zamartwiam”. Dziwna z ciebie babka, <CHARNAME>.~
@152 = ~Mam do ciebie pytanie, <CHARNAME>. Czy jesteœ bogobojn¹ osob¹?~
@153 = ~Breagarze, jestem kap³anem.~ ~Breagarze, jestem kap³ank¹.~
