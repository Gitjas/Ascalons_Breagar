@19 = ~Co tam masz w zanadrzu, co mog³oby uszczêœliwiæ Tiaxa?~
@20 = ~Shar-Teel trudno zadowoliæ, mo¿e ty bêdziesz mia³ wiêcej szczêœcia?~
@21 = ~Czym móg³by siê delektowaæ paladyn tak szlachetny jak Ajantis?~
@22 = ~Alora pewnie nie stroni od mocniejszych trunków, co?~
@23 = ~Co mo¿esz przygotowaæ dla Corana?~
@24 = ~Skomponujesz coœ dla Eldotha?~
@25 = ~Co mog³oby przypaœæ do gustu naszej druidce Faldorn?~
@26 = ~Masz drinka, którego Garrick móg³by wychwalaæ w pieœniach?~
@27 = ~Quayle przez ca³y dzieñ czaruje swoimi iluzjami, ale mo¿e ty móg³byœ wyczarowaæ mu kilka obrazów w jego g³owie?~
@28 = ~Masz coœ dla Safany?~
@29 = ~Skie wygl¹da na nieco spragnion¹, co dla niej masz?~
@30 = ~Napitek dla Yeslicka... to powinno byæ proste.~
@31 = ~Co mo¿esz zaoferowaæ czaruj¹cej Aerie?~
@32 = ~Anomen z pewnoœci¹ potrzebuje czegoœ na rozluŸnienie.~
@33 = ~Nasz cz³owiek natury, Cernd, wygl¹da na spragnionego.~
@34 = ~Edwin, Czerwony Mag, z pewnoœci¹ napi³by siê zacnego trunku.~
@35 = ~Haer'Dalis zawsze szuka jakiejœ inspiracji.~
@36 = ~Jan Jansen potrafi wypiæ wiêcej, ni¿ mog³oby siê wydawaæ.~
@37 = ~Stary, dobry Keldorn potrzebuje czegoœ, co poszerzy jego horyzonty.~
@38 = ~Korgan jest zdeterminowany, by wypiæ bardzo du¿o.~
@39 = ~Mazzy zawsze szuka nowych wra¿eñ.~
@40 = ~Co zaproponujesz Minscowi?~
@41 = ~Chcielibyœmy natychmiast dostaæ drinka dla Nalii.~
