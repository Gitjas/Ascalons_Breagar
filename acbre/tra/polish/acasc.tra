@120 = ~Aerie, nieœmia³a, powabna Aerie.~
@121 = ~Dla ciebie zmieszamy 40 ml wódki, 20 ml likieru brzoskwiniowego i 80 ml soku pomarañczowego, a na koniec powoli wlejemy 20 ml syropu ¿urawinowego. Oto „Seks na Pla¿y”.~
@122 = ~Och... CO na pla¿y?~
