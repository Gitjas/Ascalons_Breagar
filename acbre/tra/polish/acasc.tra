@53 = ~Jeœli „Bieluch” z 40 ml wódki, 20 ml Kaluha i 20 ml mleka ciê nie zadowoli, to obawiam siê, ¿e skoñczy³y mi siê pomys³y.~
@54 = ~Ascalonie, muszê przyznaæ, ¿e raz na jakiœ czas udaje ci siê dowieœæ, ¿e masz dobry gust.~
@55 = ~O, coœ dla krzy¿owca z dalekiej pó³nocy!~
@56 = ~Nie nazywam siê Ascalon, jeœli „Gin Fizz” z 40 ml ginu, 20 ml soku z cytryny, odrobiny syropu cukrowego, dope³niony wod¹ sodow¹ nie bêdzie strza³em w dziesi¹tkê!~
@57 = ~Mo¿esz zostaæ przy swoim imieniu. Ten napitek jest wyœmienity!~
@58 = ~Drink dla naszego melancholijnego przyjaciela? Ju¿ siê robi.~
@59 = ~Bierzemy po 40 ml bia³ego rumu, ginu, wódki oraz tequili, do tego 10 ml Triple Sec i 10 ml soku z cytryny. I trochê coli dla koloru.~
@60 = ~Kto nie poczuje siê szczêœliwy po jednej „Long Island Ice Tea”, ten na pewno padnie trupem po dwóch.~
@61 = ~W takim razie poproszê trzy, jeœli to mo¿liwe. Tak dla pewnoœci.~
@62 = ~Imoen, urocza dama w ró¿u!~
@63 = ~Dla ciebie b³yskawicznie przyrz¹dzimy „Cosmopolitan”: 30 ml wódki, 20 ml syropu ¿urawinowego, 20 ml Triple Sec i 10 ml soku z limonki. Na zdrowie!~
@64 = ~*chichocze* Jak wypijê jeszcze jednego, to przestanê widzieæ w³asne buty.~
@65 = ~O, Kivanie, dla ciebie drink, który przypomni ci o s³odkim ¿yciu wœród elfów.~
@66 = ~40 ml wódki, 20 ml likieru brzoskwiniowego, po 60 ml soku pomarañczowego i nektaru brzoskwiniowego oraz 10 ml grenadyny daj¹ nam „Peach Lady”. Za Deherianê!~
@67 = ~Za Deherianê.~
@68 = ~Mroczna pokusa, gorzkie piêkno, s³odka œmieræ – Viconia!~
@69 = ~Po 40 ml ginu, soku z cytryny i Blue Curacao, 60 ml soku ananasowego i 20 ml grenadyny daj¹ w efekcie „Pró¿noœæ” – drink tak mroczny i uwodzicielski, jak ty sama!~
@70 = ~Zwa¿aj na swe s³owa, jaluk, bo mo¿esz straciæ jêzyk!~
@71 = ~Kagain, krêpy i bezpoœredni, czyli krasnolud w ka¿dym calu!~
@72 = ~I taki te¿ jest „Black Jack”: 30 ml kawy, 10 ml wiœniówki i 40 ml brandy (zmieszane z du¿¹ iloœci¹ lodu, ¿eby kawa szybko ostyg³a!)~
@73 = ~I pomyœleæ, ¿e jeszcze ci p³ac¹ z³otem za tak¹ robotê...~
@74 = ~Drink dla nekromanty? Ju¿ podajê!~
@75 = ~Bierzemy po 40 ml bia³ego rumu, ciemnego rumu, soku pomarañczowego, cytrynowego i ananasowego, do tego po 20 ml rumu 78%, Cointreau, grenadyny i syropu z maracui. Tylko szaleniec wypi³by wiêcej ni¿ jednego „Zombie”.~
@76 = ~Oooooch, co za cudny kolor. Krwista czerwieñ, tak jak lubiê!~
@77 = ~Niech mistrz trucizn spróbuje zmierzyæ siê z tym oto wywarem!~
@78 = ~40 ml wódki, 40 ml Blue Curacao, 40 ml nektaru z maracui i odrobina soku z limonki daj¹ nam „Zielonego Goblina”. Na zdrowie!~
@79 = ~Jeœli nie bêdziesz ostro¿ny, to ja ci nied³ugo zaserwujê jeden z moich koktajli.~
@80 = ~Breagar, przyjacielu! To bêdzie w twoim guœcie!~
@81 = ~„Trzy Likiery” sk³adaj¹ siê z po 20 ml Southern Comfort, likieru brzoskwiniowego, Passoa i syropu migda³owego, a tak¿e 40 ml soku z cytryny, 60 ml pomarañczowego i 100 ml ananasowego.~
@82 = ~Có¿... TY pewnie wiesz najlepiej, co mi bêdzie smakowaæ.~
@83 = ~Hm, Tiax... zobaczmy.~
@84 = ~Jeœli powoli wlejemy 10 ml Baileysa do 30 ml brandy morelowej lub sznapsa jab³kowego, otrzymamy „Mózg Gonzo”! W sam raz dla gnoma!~
@85 = ~Wielki Tiax powiada, ¿e ten trunek jest godny w³adcy takiego jak ja!~
@86 = ~Shar-Teel, potê¿na i porywcza.~
@87 = ~Dla ciebie bierzemy po 30 ml bia³ego rumu i absyntu, 20 ml wódki i mleczka kokosowego, 30 ml soku ananasowego i bananowego oraz 10 ml œmietanki. Voila: Suka siê Warzy!~
@88 = ~Co chcesz przez to powiedzieæ?~
@89 = ~No to teraz czas na ciebie, szlachetny giermku! Trunek dla ciebie!~
@90 = ~Wybacz, ale Helm zakazuje spo¿ywania alkoholu.~
@91 = ~Có¿, w takim razie zrobimy tak – 40 ml soku pomarañczowego, 60 ml mleczka kokosowego i 80 ml soku ananasowego. Tak powstaje „Virgin Colada”. I jak?~
@92 = ~Bardzo smaczny. Jestem twoim d³u¿nikiem.~
@93 = ~Aloro, Aloro, ty moje s³oneczko!~
@94 = ~Uwa¿am, ¿e „Big Apple” z 30 ml likieru 43 i 60 ml soku jab³kowego bêdzie dla ciebie idealny!~
@95 = ~Drink tak s³odki jak ja. Uda³o ci siê, mistrzu!~
@96 = ~Coran! Nikt nie szyje z ³uku lepiej od ciebie!~
@97 = ~Zupe³nie jak „Alabama Slammer” z 30 ml Amaretto, 30 ml Southern Comfort i 10 ml ginu. Nie zapomnij o kropli soku z cytryny!~
@98 = ~Strza³ dziesi¹tkê!~
@99 = ~Eldoth, mój zacny bardzie!~
@100 = ~Dla ciebie mam „Roadstera”: po 30 ml likieru bananowego, œmietanki, soku pomarañczowego i brandy morelowej oraz dodatkowe 10 ml œmietanki!~
@101 = ~Wytrawny, s³odki i kremowy. Tak, to zdecydowanie drink dla mnie!~
@102 = ~Solidny trunek dla barda Garricka? Nic prostszego!~
@103 = ~Dla ciebie mamy „Gigolo” – czy cokolwiek innego by do ciebie pasowa³o? B³yskawicznie zmieszane po 20 ml srebrnej i z³otej tequili, do tego Likier 43, œmietanka, soki z mango i marakui, kropla syropu cukrowego i mleczka kokosowego. Na zdrowie!~
@104 = ~Och, có¿ za rozkosz! Bêdê ciê wychwalaæ wzd³u¿ ca³ego Wybrze¿a Mieczy!~
@105 = ~Faldorn, druidka z ostêpów Kniei Otulisko.~
@106 = ~50 ml Cachaçy, po 30 ml Charleston Follies i soku z cytryny, 15 ml syropu je¿ynowego i 5 ml syropu z maracui daj¹ nam „Je¿ynowe Odmro¿enie”. Poczujesz na jêzyku, jak las budzi siê do ¿ycia!~
@107 = ~Nie masz czegoœ bardziej naturalnego?~
